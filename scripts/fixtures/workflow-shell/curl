#!/usr/bin/env bash

# Test double for curl, on PATH in place of the real one. It serves the basename
# of the requested URL from a local directory, so a download can be made to
# deliver bytes that do or do not match their published digest.
#
# Environment:
#   FAKE_CURL_ASSETS  directory holding the files to serve

set -euo pipefail

url=""
output=""
while (( $# > 0 )); do
  case "$1" in
    -o)
      output="$2"
      shift 2
      ;;
    https://*)
      url="$1"
      shift
      ;;
    *)
      shift
      ;;
  esac
done

[[ -n "$url" && -n "$output" ]] || {
  echo "fake curl needs a URL and -o" >&2
  exit 2
}

source_file="${FAKE_CURL_ASSETS:?FAKE_CURL_ASSETS is required}/${url##*/}"
if [[ ! -f "$source_file" ]]; then
  echo "fake curl: 404 $url" >&2
  exit 22
fi
cp "$source_file" "$output"
