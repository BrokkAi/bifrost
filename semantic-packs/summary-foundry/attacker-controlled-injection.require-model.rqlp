        :selector (rql :schema-version 1
          (language java (call :callee (name "getRequestURI"))))
        :bind return-value :labels [attacker-controlled])
      (source :id src-getrequesturl-10 :display-name "HttpServletRequest.getRequestURL"
        :categories [input.user-controlled io.external]
        :selector (rql :schema-version 1
          (language java (call :callee (name "getRequestURL"))))
        :bind return-value :labels [attacker-controlled])
      (source :id src-getservletpath-11 :display-name "HttpServletRequest.getServletPath"
        :categories [input.user-controlled io.external]
        :selector (rql :schema-version 1
          (language java (call :callee (name "getServletPath"))))
        :bind return-value :labels [attacker-controlled])
      (source :id src-getenv-12 :display-name "System.getenv"
        :categories [input.user-controlled io.external]
        :selector (rql :schema-version 1
          (language java (call :callee (name "getenv"))))
        :bind return-value :labels [attacker-controlled])])
    :sinks (endpoint-set :entries [
      (sink :id snk-processbuilder-0 :display-name "ProcessBuilder.ProcessBuilder"
        :categories [data.sensitive]
        :selector (rql :schema-version 1
          (language java (call :callee (name "ProcessBuilder"))))
        :dangerous-operand (argument :index 0) :accepts [attacker-controlled])
      (sink :id snk-addbatch-1 :display-name "Statement.addBatch"
        :categories [data.sensitive]
        :selector (rql :schema-version 1
          (language java (call :callee (name "addBatch"))))
        :dangerous-operand (argument :index 0) :accepts [attacker-controlled])
      (sink :id snk-addcookie-2 :display-name "HttpServletResponse.addCookie"
