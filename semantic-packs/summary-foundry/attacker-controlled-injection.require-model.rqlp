        :categories [input.user-controlled io.external]
        :selector (rql :schema-version 1
          (language java (call :callee (name "getParameterNames"))))
        :bind return-value :labels [attacker-controlled])
      (source :id src-getparametervalues-6 :display-name "HttpServletRequest.getParameterValues"
        :categories [input.user-controlled io.external]
        :selector (rql :schema-version 1
          (language java (call :callee (name "getParameterValues"))))
        :bind return-value :labels [attacker-controlled])
      (source :id src-getpathinfo-7 :display-name "HttpServletRequest.getPathInfo"
        :categories [input.user-controlled io.external]
        :selector (rql :schema-version 1
          (language java (call :callee (name "getPathInfo"))))
        :bind return-value :labels [attacker-controlled])
      (source :id src-getquerystring-8 :display-name "HttpServletRequest.getQueryString"
        :categories [input.user-controlled io.external]
        :selector (rql :schema-version 1
          (language java (call :callee (name "getQueryString"))))
