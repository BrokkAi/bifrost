(policy
  :schema-version 1
  :id "bifrost.summary-foundry.attacker-controlled-injection.require-model"
  :name "Attacker-controlled data reaches an injection sink (require-model)"
  :message "attacker-controlled data reached an injection sink"
  :severity warning
  :analysis (analysis
    :type taint
    :mode may
    :call-modeling (call-modeling :unmodeled require-model)
    :sources (endpoint-set :entries [
      (source :id src-getheader-0 :display-name "HttpServletRequest.getHeader"
        :categories [input.user-controlled io.external]
        :selector (rql :schema-version 1
          (language java (call :callee (name "getHeader"))))
        :bind return-value :labels [attacker-controlled])
      (source :id src-getheadernames-1 :display-name "HttpServletRequest.getHeaderNames"
        :categories [input.user-controlled io.external]
        :selector (rql :schema-version 1
          (language java (call :callee (name "getHeaderNames"))))
        :bind return-value :labels [attacker-controlled])
      (source :id src-getheaders-2 :display-name "HttpServletRequest.getHeaders"
        :categories [input.user-controlled io.external]
        :selector (rql :schema-version 1
          (language java (call :callee (name "getHeaders"))))
        :bind return-value :labels [attacker-controlled])
      (source :id src-getparameter-3 :display-name "HttpServletRequest.getParameter"
        :categories [input.user-controlled io.external]
        :selector (rql :schema-version 1
          (language java (call :callee (name "getParameter"))))
        :bind return-value :labels [attacker-controlled])
      (source :id src-getparametermap-4 :display-name "HttpServletRequest.getParameterMap"
