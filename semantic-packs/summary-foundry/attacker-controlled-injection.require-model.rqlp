      (sink :id snk-setheader-14 :display-name "HttpServletResponse.setHeader"
        :categories [data.sensitive]
        :selector (rql :schema-version 1
          (language java (call :callee (name "setHeader"))))
        :dangerous-operand (argument :index 0) :accepts [attacker-controlled])
      (sink :id snk-setheader-15 :display-name "HttpServletResponse.setHeader"
        :categories [data.sensitive]
        :selector (rql :schema-version 1
          (language java (call :callee (name "setHeader"))))
        :dangerous-operand (argument :index 1) :accepts [attacker-controlled])]))
  :classification (classification
    :fallback (classification-id :taxonomy "Foundry" :id "SUMMARY-INJECTION")))
