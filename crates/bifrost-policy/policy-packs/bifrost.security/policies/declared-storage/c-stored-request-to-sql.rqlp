; Declared-storage SQL flow, C specialization.
(policy
  :schema-version 1
  :id "bifrost.security.c.stored-request-to-sql"
  :name "Stored request value reaches SQL (C)"
  :message "a request value stored in the declared job store reached SQL text"
  :severity error
  :description "Reports request values that cross the declared job-store persistence boundary and reach sqlite3 SQL text. Selection is exact: proven calls of the declared functions only, never same-named internal-linkage definitions in unrelated translation units. The store, key, and instance contracts come from the reviewed endpoint-set document, whose absence fails activation rather than passing."
  :help-uri "https://bifrost.brokk.ai/static-analysis-policies/#declared-storage"
  :tags ["security" "c" "sql-injection" "cwe-89" "declared-storage"]
  :analysis (analysis
    :type taint
    :mode may
    :call-modeling (call-modeling :unmodeled paranoid)
    :sources (endpoint-set :entries [
      (source :id request-param
        :display-name "request parameter"
        :categories [input.user-controlled io.external]
        :selector (rql :schema-version 1
          (language c
            (call-sites-to :proof proven
              (enclosing-decl (function :name "request_param")))))
        :bind return-value
        :labels [attacker-controlled])])
    :sinks (endpoint-set :entries [
      (sink :id sqlite3-exec
        :display-name "sqlite3 exec SQL"
        :categories [sql.structure]
        :selector (rql :schema-version 1
          (language c
            (call-sites-to :proof proven
              (enclosing-decl (function :name "sqlite3_exec_text")))))
        :dangerous-operand (argument :index 0)
        :accepts [attacker-controlled])])
    :stores (endpoint-set :include-files [
      (endpoint-set-file :path ".bifrost/endpoint-sets/stores/c-declared-store.rqlp")]))
  :classification (classification
    :fallback (classification-id :taxonomy "CWE" :id "89")))
