; Declared-storage SQL flow, C# specialization.
;
; Capability note: C# taint discovery currently fails closed with "procedure
; semantics unknown" whenever a batch binds two matched endpoints (a source
; and a sink), so selecting this policy today reports an inconclusive run
; rather than the flow below. The endpoint, store, and validation contracts
; are exact and stay valid once the substrate gap closes.
(policy
  :schema-version 1
  :id "bifrost.security.csharp.stored-request-to-sql"
  :name "Stored request value reaches SQL (C#)"
  :message "a request value stored in the declared job store reached SQL text"
  :severity error
  :description "Reports request values that cross the declared job-store persistence boundary and reach SQL text. Selection is exact: proven calls of the declared APIs only, never same-named members of unrelated classes. The store, key, and instance contracts come from the reviewed endpoint-set document, whose absence fails activation rather than passing."
  :help-uri "https://bifrost.brokk.ai/static-analysis-policies/#declared-storage"
  :tags ["security" "csharp" "sql-injection" "cwe-89" "declared-storage"]
  :analysis (analysis
    :type taint
    :mode may
    :call-modeling (call-modeling :unmodeled require-model)
    :sources (endpoint-set :entries [
      (source :id request-query-get
        :display-name "Request.Query get"
        :categories [input.user-controlled io.external]
        :selector (rql :schema-version 1
          (language csharp
            (call-sites-to :proof proven
              (enclosing-decl
                (inside-decl (class :name "RequestQuery") (method :name "Get"))))))
        :bind return-value
        :labels [attacker-controlled])])
    :sinks (endpoint-set :entries [
      (sink :id sql-execute-raw
        :display-name "SQL ExecuteRaw"
        :categories [sql.structure]
        :selector (rql :schema-version 1
          (language csharp
            (call-sites-to :proof proven
              (enclosing-decl
                (inside-decl (class :name "Sql") (method :name "ExecuteRaw"))))))
        :dangerous-operand (argument :index 0)
        :accepts [attacker-controlled])])
    :stores (endpoint-set :include-files [
      (endpoint-set-file :path ".bifrost/endpoint-sets/stores/csharp-declared-store.rqlp")]))
  :classification (classification
    :fallback (classification-id :taxonomy "CWE" :id "89")))
