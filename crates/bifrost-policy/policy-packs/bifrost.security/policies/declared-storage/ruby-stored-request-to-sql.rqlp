; Declared-storage SQL flow, Ruby specialization.
(policy
  :schema-version 1
  :id "bifrost.security.ruby.stored-request-to-sql"
  :name "Stored request value reaches SQL (Ruby)"
  :message "a request value stored in the declared job store reached SQL text"
  :severity error
  :description "Reports request values that cross the declared job-store persistence boundary and reach connection.execute SQL text. Selection is exact: proven calls of the declared APIs only, never same-named members of unrelated classes. The store, key, and instance contracts come from the reviewed endpoint-set document, whose absence fails activation rather than passing."
  :help-uri "https://bifrost.brokk.ai/static-analysis-policies/#declared-storage"
  :tags ["security" "ruby" "sql-injection" "cwe-89" "declared-storage"]
  :analysis (analysis
    :type taint
    :mode may
    :call-modeling (call-modeling :unmodeled require-model)
    :sources (endpoint-set :entries [
      (source :id rails-params-fetch
        :display-name "params.fetch"
        :categories [input.user-controlled io.external]
        :selector (rql :schema-version 1
          (language ruby
            (call-sites-to :proof proven
              (enclosing-decl
                (inside-decl (class :name "RequestParams") (method :name "fetch"))))))
        :bind return-value
        :labels [attacker-controlled])])
    :sinks (endpoint-set :entries [
      (sink :id connection-execute
        :display-name "connection.execute SQL"
        :categories [sql.structure]
        :selector (rql :schema-version 1
          (language ruby
            (call-sites-to :proof proven
              (enclosing-decl
                (inside-decl (class :name "Connection") (method :name "execute"))))))
        :dangerous-operand (argument :index 0)
        :accepts [attacker-controlled])])
    :stores (endpoint-set :include-files [
      (endpoint-set-file :path ".bifrost/endpoint-sets/stores/ruby-declared-store.rqlp")]))
  :classification (classification
    :fallback (classification-id :taxonomy "CWE" :id "89")))
