; Declared-storage SQL flow, Go specialization.
(policy
  :schema-version 1
  :id "bifrost.security.go.stored-request-to-sql"
  :name "Stored request value reaches SQL (Go)"
  :message "a request value stored in the declared job store reached SQL text"
  :severity error
  :description "Reports net/http request values that cross the declared job-store persistence boundary and reach database/sql SQL text. Selection is exact: proven calls of the declared functions only, never same-named methods of unrelated types. The store, key, and instance contracts come from the reviewed endpoint-set document, whose absence fails activation rather than passing."
  :help-uri "https://bifrost.brokk.ai/static-analysis-policies/#declared-storage"
  :tags ["security" "go" "sql-injection" "cwe-89" "declared-storage"]
  :analysis (analysis
    :type taint
    :mode may
    :call-modeling (call-modeling :unmodeled require-model)
    :sources (endpoint-set :entries [
      (source :id http-form-value
        :display-name "Request.FormValue"
        :categories [input.user-controlled io.external]
        :selector (rql :schema-version 1
          (language go
            (call-sites-to :proof proven
              (enclosing-decl (function :name "FormValue")))))
        :bind return-value
        :labels [attacker-controlled])])
    :sinks (endpoint-set :entries [
      (sink :id sql-exec
        :display-name "sql.Exec SQL"
        :categories [sql.structure]
        :selector (rql :schema-version 1
          (language go
            (call-sites-to :proof proven
              (enclosing-decl (function :name "Exec")))))
        :dangerous-operand (argument :index 0)
        :accepts [attacker-controlled])])
    :stores (endpoint-set :include-files [
      (endpoint-set-file :path ".bifrost/endpoint-sets/stores/go-declared-store.rqlp")]))
  :classification (classification
    :fallback (classification-id :taxonomy "CWE" :id "89")))
