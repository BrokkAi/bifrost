; Declared-storage SQL flow, TypeScript specialization.
;
; A request value (Express req.param) that the application persists through
; its declared job store and later reads back must never reach the SQL text
; of a pg Client.query call. The write-to-read edge is the workspace's
; reviewed store declaration, not an observed database connection; the
; policy binds no flow without it. Parameter binding
; (`query("... $1", [term])`) keeps the value out of the SQL structure and
; is the documented remediation.
(policy
  :schema-version 1
  :id "bifrost.security.typescript.stored-request-to-sql"
  :name "Stored request value reaches pg SQL (TypeScript)"
  :message "a request value stored in the declared job store reached pg Client.query SQL text"
  :severity error
  :description "Reports Express request values that cross the declared job-store persistence boundary and reach the SQL argument of a pg Client.query call. Selection is exact: proven calls of the declared APIs only, never same-named members of unrelated classes. The store, key, and instance contracts come from the reviewed endpoint-set document, whose absence fails activation rather than passing."
  :help-uri "https://bifrost.brokk.ai/static-analysis-policies/#declared-storage"
  :tags ["security" "typescript" "sql-injection" "cwe-89" "declared-storage"]
  :analysis (analysis
    :type taint
    :mode may
    :call-modeling (call-modeling :unmodeled require-model)
    :sources (endpoint-set :entries [
      (source :id express-request-param
        :display-name "Express req.param"
        :categories [input.user-controlled io.external]
        :selector (rql :schema-version 1
          (language typescript
            (call-sites-to :proof proven
              (enclosing-decl
                (inside-decl (class :name "RequestQuery") (method :name "param"))))))
        :bind return-value
        :labels [attacker-controlled])])
    :sinks (endpoint-set :entries [
      (sink :id pg-client-query
        :display-name "pg Client.query SQL"
        :categories [sql.structure]
        :selector (rql :schema-version 1
          (language typescript
            (call-sites-to :proof proven
              (enclosing-decl
                (inside-decl (class :name "Client") (method :name "query"))))))
        :dangerous-operand (argument :index 0)
        :accepts [attacker-controlled])])
    :stores (endpoint-set :include-files [
      (endpoint-set-file :path ".bifrost/endpoint-sets/stores/typescript-declared-store.rqlp")]))
  :classification (classification
    :fallback (classification-id :taxonomy "CWE" :id "89")))
