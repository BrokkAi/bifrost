; Declared-storage SQL flow, Scala specialization.
(policy
  :schema-version 1
  :id "bifrost.security.scala.stored-request-to-sql"
  :name "Stored request value reaches JDBC SQL (Scala)"
  :message "a request value stored in the declared job store reached Statement.execute(String) SQL text"
  :severity error
  :description "Reports request values that cross the declared job-store persistence boundary and reach the SQL argument of a JDBC Statement.execute(String) call. Selection is exact: proven calls of the declared APIs only, never same-named members of unrelated classes. The store, key, and instance contracts come from the reviewed endpoint-set document, whose absence fails activation rather than passing."
  :help-uri "https://bifrost.brokk.ai/static-analysis-policies/#declared-storage"
  :tags ["security" "scala" "sql-injection" "cwe-89" "declared-storage"]
  :analysis (analysis
    :type taint
    :mode may
    :call-modeling (call-modeling :unmodeled require-model)
    :sources (endpoint-set :entries [
      (source :id play-query-string-get
        :display-name "request queryString get"
        :categories [input.user-controlled io.external]
        :selector (rql :schema-version 1
          (language scala
            (call-sites-to :proof proven
              (enclosing-decl
                (inside-decl (class :name "QueryString") (method :name "get"))))))
        :bind return-value
        :labels [attacker-controlled])])
    :sinks (endpoint-set :entries [
      (sink :id jdbc-statement-execute
        :display-name "Statement.execute SQL"
        :categories [sql.structure]
        :selector (rql :schema-version 1
          (language scala
            (call-sites-to :proof proven
              (enclosing-decl
                (inside-decl (class :name "Statement") (method :name "execute"))))))
        :dangerous-operand (argument :index 0)
        :accepts [attacker-controlled])])
    :stores (endpoint-set :include-files [
      (endpoint-set-file :path ".bifrost/endpoint-sets/stores/scala-declared-store.rqlp")]))
  :classification (classification
    :fallback (classification-id :taxonomy "CWE" :id "89")))
