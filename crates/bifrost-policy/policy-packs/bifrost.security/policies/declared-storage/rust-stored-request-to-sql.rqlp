; Declared-storage SQL flow, Rust specialization.
(policy
  :schema-version 1
  :id "bifrost.security.rust.stored-request-to-sql"
  :name "Stored request value reaches SQL (Rust)"
  :message "a request value stored in the declared job store reached SQL text"
  :severity error
  :description "Reports request values that cross the declared job-store persistence boundary and reach SQL text. Selection is exact: proven calls of the declared APIs only, never same-named functions in other modules. The store, key, and instance contracts come from the reviewed endpoint-set document, whose absence fails activation rather than passing."
  :help-uri "https://bifrost.brokk.ai/static-analysis-policies/#declared-storage"
  :tags ["security" "rust" "sql-injection" "cwe-89" "declared-storage"]
  :analysis (analysis
    :type taint
    :mode may
    :call-modeling (call-modeling :unmodeled require-model)
    :sources (endpoint-set :entries [
      (source :id request-query-value
        :display-name "request query value"
        :categories [input.user-controlled io.external]
        :selector (rql :schema-version 1
          (language rust
            (call-sites-to :proof proven
              (enclosing-decl
                (inside-decl (module :name "apis") (function :name "query_value"))))))
        :bind return-value
        :labels [attacker-controlled])])
    :sinks (endpoint-set :entries [
      (sink :id sql-execute
        :display-name "SQL execute"
        :categories [sql.structure]
        :selector (rql :schema-version 1
          (language rust
            (call-sites-to :proof proven
              (enclosing-decl
                (inside-decl (module :name "apis") (function :name "execute"))))))
        :dangerous-operand (argument :index 0)
        :accepts [attacker-controlled])])
    :stores (endpoint-set :include-files [
      (endpoint-set-file :path ".bifrost/endpoint-sets/stores/rust-declared-store.rqlp")]))
  :classification (classification
    :fallback (classification-id :taxonomy "CWE" :id "89")))
