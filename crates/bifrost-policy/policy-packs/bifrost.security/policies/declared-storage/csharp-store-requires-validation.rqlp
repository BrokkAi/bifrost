; Declared-storage required validation, C# specialization.
;
; Capability note: C# taint discovery currently fails closed with "procedure
; semantics unknown" whenever a batch binds two matched endpoints (an origin
; and an observation), so selecting this policy today reports an
; inconclusive run rather than the obligation below.
(policy
  :schema-version 1
  :id "bifrost.security.csharp.store-requires-validation"
  :name "Stored request value requires the configured validator (C#)"
  :message "a request value reached the declared job store without passing the configured validator"
  :severity warning
  :description "Diagnoses request values that reach the declared job-store write without passing through the validator the workspace configured. The observed store write and the required validator are exact proven calls named by the reviewed endpoint-set documents; selecting this policy without that configuration fails activation rather than reporting a clean pass."
  :help-uri "https://bifrost.brokk.ai/static-analysis-policies/#declared-storage"
  :tags ["security" "csharp" "provenance" "declared-storage"]
  :analysis (analysis
    :type flow
    :mode may
    :call-modeling (call-modeling :unmodeled paranoid)
    :origins (endpoint-set :entries [
      (origin :id request-query-get
        :display-name "Request.Query get"
        :selector (rql :schema-version 1
          (language csharp
            (call-sites-to :proof proven
              (enclosing-decl
                (inside-decl (class :name "RequestQuery") (method :name "Get"))))))
        :bind return-value)])
    :observations (endpoint-set :include-files [
      (endpoint-set-file :path ".bifrost/endpoint-sets/observations/csharp-declared-store-write.rqlp")])
    :kills (endpoint-set :include-files [
      (endpoint-set-file :path ".bifrost/endpoint-sets/kills/csharp-required-validator.rqlp")])))
