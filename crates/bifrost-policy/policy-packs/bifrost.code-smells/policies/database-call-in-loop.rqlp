(policy
  :schema-version 1
  :id "bifrost.performance.database-call-in-loop"
  :name "Database call inside a loop"
  :message "Review whether this lexically nested database call repeats per iteration"
  :severity warning
  :description "A database call lexically nested under a loop can signal an N+1 pattern. This structural prompt also includes deferred nested bodies; verify execution before batching or prefetching."
  :help-uri "https://bifrost.brokk.ai/static-analysis-policies/#built-in-code-smell-pack"
  :tags ["performance" "database" "n-plus-one" "loop" "code-smell"]
  :analysis
    (analysis
      :type match
      :selector
        (rql
          :schema-version 1
          (union
            (language python
              (inside-decl (loop) (call :receiver (name "cursor") :callee (name "execute"))))
            (language java
              (inside-decl (loop) (call :receiver (name "statement") :callee (name "executeQuery"))))
            (language javascript
              (inside-decl (loop) (call :receiver (name "db") :callee (name "query"))))
            (language typescript
              (inside-decl (loop) (call :receiver (name "db") :callee (name "query"))))))))
