(policy
  :schema-version 1
  :id "bifrost.performance.network-call-in-loop"
  :name "Network request inside a loop"
  :message "Review whether this lexically nested network request repeats per iteration"
  :severity warning
  :description "A network call lexically nested under a loop may amplify latency and remote load. This structural prompt also includes deferred nested bodies; verify execution before batching or adding bounded concurrency."
  :help-uri "https://bifrost.brokk.ai/static-analysis-policies/#built-in-code-smell-pack"
  :tags ["performance" "network" "loop" "code-smell"]
  :analysis
    (analysis
      :type match
      :selector
        (rql
          :schema-version 1
          (union
            (language python
              (inside-decl (loop) (call :receiver (name "requests") :callee (name "get"))))
            (language python
              (inside-decl (loop) (call :receiver (name "requests") :callee (name "post"))))
            (language java
              (inside-decl (loop) (call :receiver (name "client") :callee (name "send"))))
            (language javascript (inside-decl (loop) (call :callee (name "fetch"))))
            (language typescript (inside-decl (loop) (call :callee (name "fetch"))))
            (language rust
              (inside-decl (loop) (call :receiver (name "reqwest") :callee (name "get"))))
            (language rust
              (inside-decl
                (loop)
                (call
                  :receiver (name "ureq")
                  :callee (name/regex "^(get|post)$"))))))))
