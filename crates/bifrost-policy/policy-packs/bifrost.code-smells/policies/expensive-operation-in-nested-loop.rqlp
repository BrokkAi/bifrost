(policy
  :schema-version 1
  :id "bifrost.performance.expensive-operation-in-nested-loop"
  :name "Expensive operation inside nested loops"
  :message "Review whether this lexically nested operation repeats across both loops"
  :severity warning
  :description "This operation is lexically nested under two loops. The structural prompt also includes deferred nested bodies; verify execution before hoisting invariants, batching work, or reducing the iteration space."
  :help-uri "https://bifrost.brokk.ai/static-analysis-policies/#built-in-code-smell-pack"
  :tags ["performance" "nested-loop" "io" "code-smell"]
  :analysis
    (analysis
      :type match
      :selector
        (rql
          :schema-version 1
          (union
            (language python
              (loop
                (has
                  (loop
                    (has
                      (call :callee (name "open")))))))
            (language java
              (loop
                (has
                  (loop
                    (has
                      (call :callee (name "readAllBytes")))))))
            (language javascript
              (loop
                (has
                  (loop
                    (has
                      (call :callee (name "fetch")))))))
            (language typescript
              (loop
                (has
                  (loop
                    (has
                      (call :callee (name "parse")))))))
            (language rust
              (loop
                (has
                  (loop
                    (has
                      (call
                        :receiver (name "fs")
                        :callee (name/regex "^(read|read_to_string)$")))))))))))
