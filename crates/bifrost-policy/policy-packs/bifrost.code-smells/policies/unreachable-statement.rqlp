; An exact Java statement has no entry reachable from its procedure entry.
(policy
  :schema-version 1
  :id "bifrost.correctness.unreachable-statement"
  :name "Unreachable statement"
  :message "this statement cannot execute"
  :severity warning
  :description "Every producer-authored entry to this exact Java statement is outside the complete bounded control-flow region reachable from the procedure entry. Missing statement entries, unknown control, source mismatch, cancellation, and budget exhaustion remain inconclusive. Review the preceding flow and intended statement before removing code."
  :help-uri "https://bifrost.brokk.ai/static-analysis-policies/#built-in-code-smell-pack"
  :tags ["correctness" "control-flow" "code-smell"]
  :analysis (analysis
    :type assertion
    (bind :name statement
      :query (rql :schema-version 1
        (filter :where ((verdict eq unreachable))
          (language java
            (statement-reachability
              (procedure-of
                (callable)))))))
    (group :name by-statement :by (statement.id)
      (aggregate :name violations :op count))
    (assert :group by-statement :value violations :cardinality (exactly 0))))
