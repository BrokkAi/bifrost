(policy
  :schema-version 1
  :id "bifrost.performance.parsing-in-loop"
  :name "Parsing inside a loop"
  :message "Review whether this lexically nested parse repeats invariant work"
  :severity note
  :description "A parse call lexically nested under a loop may repeat tokenization, validation, and allocation. This structural prompt also includes deferred nested bodies; verify execution and invariance before hoisting it. A for-each loop whose iterated expression provably resolves to a collection literal with at most eight elements is excluded; the proof covers declarator-established bindings (JS/TS const/let/var, Rust let, Java locals), so field-, assignment-, or call-produced iterables still report."
  :help-uri "https://bifrost.brokk.ai/static-analysis-policies/#built-in-code-smell-pack"
  :tags ["performance" "parsing" "loop" "code-smell"]
  :analysis
    (analysis
      :type assertion
      :subject
        (rql
          :schema-version 1
          (union
            (language python
              (inside-decl (loop :capture "region") (call :receiver (name "json") :callee (name "loads") :capture "smell")))
            (language java
              (inside-decl (loop :capture "region") (call :callee (name "parse") :capture "smell")))
            (language javascript
              (inside-decl (loop :capture "region") (call :receiver (name "JSON") :callee (name "parse") :capture "smell")))
            (language typescript
              (inside-decl (loop :capture "region") (call :receiver (name "JSON") :callee (name "parse") :capture "smell")))
            (language rust
              (inside-decl
                (loop :capture "region")
                (call
                  :receiver (name "serde_json")
                  :callee (name/regex "^(from_str|from_slice)$") :capture "smell")))
            (language rust
              (inside-decl (loop :capture "region") (call :receiver (name "bincode") :callee (name "deserialize") :capture "smell")))
            (language rust
              (inside-decl (loop :capture "region") (call :receiver (name "toml") :callee (name "from_str") :capture "smell")))))
      :asserts [
        (assert-origin-shape :id small-literal-iterable :at "region" :anchor "smell"
                             :role value_reference :shape collection-literal :max-elements 8)
      ]))
