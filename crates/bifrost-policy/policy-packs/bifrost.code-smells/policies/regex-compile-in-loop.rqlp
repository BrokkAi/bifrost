(policy
  :schema-version 1
  :id "bifrost.performance.regex-compile-in-loop"
  :name "Regular-expression compilation inside a loop"
  :message "Review whether this lexically nested regex compilation repeats per iteration"
  :severity note
  :description "Regex compilation lexically nested under a loop may rebuild parser and matcher state. This structural prompt also includes deferred nested bodies; verify execution and invariance before hoisting it. A for-each loop whose iterated expression provably resolves to a collection literal with at most eight elements is excluded; the proof covers declarator-established bindings (JS/TS const/let/var, Rust let, Java locals), so field-, assignment-, or call-produced iterables still report."
  :help-uri "https://bifrost.brokk.ai/static-analysis-policies/#built-in-code-smell-pack"
  :tags ["performance" "regex" "loop" "code-smell"]
  :analysis
    (analysis
      :type assertion
      :subject
        (rql
          :schema-version 1
          (union
            (language python
              (inside-decl (loop :capture "region") (call :receiver (name "re") :callee (name "compile") :capture "smell")))
            (language java
              (inside-decl (loop :capture "region") (call :receiver (name "Pattern") :callee (name "compile") :capture "smell")))
            (language javascript
              (inside-decl (loop :capture "region") (call :callee (name "RegExp") :capture "smell")))
            (language typescript
              (inside-decl (loop :capture "region") (call :callee (name "RegExp") :capture "smell")))
            (language rust
              (inside-decl (loop :capture "region") (call :receiver (name "Regex") :callee (name "new") :capture "smell")))))
      :asserts [
        (assert-origin-shape :id small-literal-iterable :at "region" :anchor "smell"
                             :role value_reference :shape collection-literal :max-elements 8)
      ]))
