; Files.deleteIfExists(Path) returns false when the file did not exist. The
; false status is not an I/O exception; I/O failures are thrown separately.
; This policy asks only whether the reviewed status value was discarded.
(policy
  :schema-version 1
  :id "bifrost.correctness.ignored-status-result"
  :name "Ignored file-deletion status"
  :message "the reviewed deletion status is discarded"
  :severity note
  :description "The exact JDK 21 Files.deleteIfExists(Path) call returns a Boolean status: false means no file was deleted because it did not exist. An expression statement or for-loop initializer/update discards that status. Expression lambdas require a resolved functional return contract. I/O exceptions remain separate. This diagnostic requires exact selected-artifact and dispatch evidence; it does not claim that discarding the status is always a bug."
  :help-uri "https://bifrost.brokk.ai/static-analysis-policies/#built-in-code-smell-pack"
  :tags ["correctness" "java" "result-use" "status"]
  :analysis (analysis
    :type assertion
    (bind :name discarded
      :query (rql :schema-version 1
        (filter :where ((obligation_kind eq fallible_status)
                        (failure_predicate eq (enum false))
                        (result_use eq discarded)
                        (coverage eq exhaustive)
                        (terminal eq false))
          (language java
            (call-result-obligations
              (call-shape (call :callee "deleteIfExists")))))))
    (group :name by-call :by (discarded.id)
      (aggregate :name ignored-statuses :op count))
    (assert :group by-call :value ignored-statuses :cardinality (exactly 0))))
