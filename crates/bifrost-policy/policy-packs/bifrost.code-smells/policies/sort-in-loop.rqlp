(policy
  :schema-version 1
  :id "bifrost.performance.sort-in-loop"
  :name "Sorting inside a loop"
  :message "Review whether this lexically nested sort repeats per iteration"
  :severity warning
  :description "A sort call lexically nested under a loop may multiply comparison and allocation work. This structural prompt also includes deferred nested bodies; verify execution and invariance before hoisting it."
  :help-uri "https://bifrost.brokk.ai/static-analysis-policies/#built-in-code-smell-pack"
  :tags ["performance" "collections" "loop" "code-smell"]
  :analysis
    (analysis
      :type match
      :selector
        (rql
          :schema-version 1
          (union
            (where
              "*.py" "**/*.py"
              "*.java" "**/*.java"
              "*.ts" "**/*.ts"
              "*.tsx" "**/*.tsx"
              (inside-decl (loop) (call :callee (name "sort"))))
            (language rust
              (inside-decl
                (loop)
                (call
                  :callee
                    (name/regex "^(sort|sort_by|sort_by_key|sort_by_cached_key|sort_unstable|sort_unstable_by|sort_unstable_by_key)$"))))))))
