(policy
  :schema-version 1
  :id "bifrost.performance.serialization-in-loop"
  :name "Serialization inside a loop"
  :message "Review whether this lexically nested serialization repeats per iteration"
  :severity note
  :description "Serialization lexically nested under a loop may repeat traversal, encoding, and allocation. This structural prompt also includes deferred nested bodies; verify execution before hoisting or batching. A for-each loop whose iterated expression provably resolves to a collection literal with at most eight elements is excluded; the proof covers declarator-established bindings (JS/TS const/let/var, Rust let, Java locals), so field-, assignment-, or call-produced iterables still report."
  :help-uri "https://bifrost.brokk.ai/static-analysis-policies/#built-in-code-smell-pack"
  :tags ["performance" "serialization" "loop" "code-smell"]
  :analysis
    (analysis
      :type assertion
      :subject
        (rql
          :schema-version 1
          (union
            (language python
              (inside-decl (loop :capture "region") (call :receiver (name "json") :callee (name "dumps") :capture "smell")))
            (language java
              (inside-decl (loop :capture "region") (call :callee (name "writeValueAsString") :capture "smell")))
            (language javascript
              (inside-decl (loop :capture "region") (call :receiver (name "JSON") :callee (name "stringify") :capture "smell")))
            (language typescript
              (inside-decl (loop :capture "region") (call :receiver (name "JSON") :callee (name "stringify") :capture "smell")))
            (language rust
              (inside-decl
                (loop :capture "region")
                (call
                  :receiver (name "serde_json")
                  :callee (name/regex "^(to_string|to_vec)$") :capture "smell")))
            (language rust
              (inside-decl (loop :capture "region") (call :receiver (name "bincode") :callee (name "serialize") :capture "smell")))))
      :asserts [
        (assert-origin-shape :id small-literal-iterable :at "region" :anchor "smell"
                             :role value_reference :shape collection-literal :max-elements 8)
      ]))
