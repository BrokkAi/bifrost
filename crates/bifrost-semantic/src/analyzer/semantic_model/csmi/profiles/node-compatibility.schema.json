{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csmi.brokk.ai/schema/profiles/node-compatibility/0.1/schema.json",
  "title": "CSMI Node compatibility profile 0.1 values",
  "oneOf": [
    { "$ref": "#/$defs/nodeRuntime" },
    { "$ref": "#/$defs/nodeModuleResolution" },
    { "$ref": "#/$defs/typescriptResolution" }
  ],
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "semverBound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "inclusive"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "inclusive": { "type": "boolean" }
      }
    },
    "semverInterval": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "minimum": { "$ref": "#/$defs/semverBound" },
        "maximum": { "$ref": "#/$defs/semverBound" }
      }
    },
    "stringSet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "lowerCaseKeySet": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      }
    },
    "conditionSet": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "not": { "const": "default" }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nodeRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "versionInterval"],
      "properties": {
        "kind": { "const": "node-runtime" },
        "versionInterval": { "$ref": "#/$defs/semverInterval" },
        "platforms": { "$ref": "#/$defs/lowerCaseKeySet" },
        "architectures": { "$ref": "#/$defs/lowerCaseKeySet" }
      }
    },
    "nodeModuleResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "moduleSystem",
        "packageExport",
        "conditions",
        "resolvedTargetDigest"
      ],
      "properties": {
        "kind": { "const": "node-module-resolution" },
        "moduleSystem": { "enum": ["commonjs", "esm"] },
        "packageExport": {
          "type": "string",
          "pattern": "^(?:\\.|\\./[^/](?:.*[^/])?)$"
        },
        "conditions": { "$ref": "#/$defs/conditionSet" },
        "resolvedTargetDigest": { "$ref": "#/$defs/sha256" }
      }
    },
    "typescriptResolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "compilerVersionInterval",
        "moduleResolution",
        "moduleKind",
        "conditions"
      ],
      "properties": {
        "kind": { "const": "typescript-resolution" },
        "compilerVersionInterval": { "$ref": "#/$defs/semverInterval" },
        "moduleResolution": {
          "enum": ["node10", "node16", "nodenext", "bundler"]
        },
        "moduleKind": {
          "enum": ["commonjs", "es2020", "es2022", "esnext", "node16", "node18", "node20", "nodenext", "preserve"]
        },
        "conditions": { "$ref": "#/$defs/conditionSet" },
        "jsxMode": {
          "enum": ["preserve", "react", "react-jsx", "react-jsxdev", "react-native"]
        },
        "effectiveOptionsDigest": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
