{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csmi.brokk.ai/schema/profiles/python/0.1/schema.json",
  "title": "CSMI Python interoperability profile 0.1 payloads",
  "oneOf": [
    { "$ref": "#/$defs/distributionImports" },
    { "$ref": "#/$defs/importBindings" },
    { "$ref": "#/$defs/declarationCorrespondence" },
    { "$ref": "#/$defs/compatibility" }
  ],
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "localId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$" },
    "purl": { "type": "string", "pattern": "^pkg:" },
    "modulePath": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nonEmptyString" }
    },
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "coverage", "canonicalization", "value"],
      "properties": {
        "algorithm": { "enum": ["sha-256", "sha-384", "sha-512"] },
        "coverage": { "$ref": "#/$defs/nonEmptyString" },
        "canonicalization": { "type": "string", "format": "uri" },
        "value": { "type": "string", "pattern": "^[0-9a-f]+$" }
      },
      "allOf": [
        {
          "if": { "properties": { "algorithm": { "const": "sha-256" } } },
          "then": { "properties": { "value": { "pattern": "^[0-9a-f]{64}$" } } }
        },
        {
          "if": { "properties": { "algorithm": { "const": "sha-384" } } },
          "then": { "properties": { "value": { "pattern": "^[0-9a-f]{96}$" } } }
        },
        {
          "if": { "properties": { "algorithm": { "const": "sha-512" } } },
          "then": { "properties": { "value": { "pattern": "^[0-9a-f]{128}$" } } }
        }
      ]
    },
    "condition": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "python": {
          "type": "string",
          "pattern": "^(?:vers:generic/.+|[0-9]+(?:\\.[0-9]+)+(?:[a-z0-9.-]+)?)$"
        },
        "implementation": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        },
        "abi": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
        },
        "platform": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
        },
        "extras": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        },
        "projectConfig": { "$ref": "#/$defs/digest" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "minProperties": 2,
      "properties": {
        "kind": { "const": "compatibility" },
        "python": {
          "type": "string",
          "pattern": "^(?:vers:generic/.+|[0-9]+(?:\\.[0-9]+)+(?:[a-z0-9.-]+)?)$"
        },
        "implementation": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        },
        "abi": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
        },
        "platform": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" }
        },
        "extras": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
        },
        "projectConfig": { "$ref": "#/$defs/digest" }
      }
    },
    "distributionImports": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "importRoots"],
      "properties": {
        "kind": { "const": "distribution-imports" },
        "importRoots": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/modulePath" }
        },
        "namespaceContributions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/modulePath" }
        },
        "conditions": { "$ref": "#/$defs/condition" }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "bindingKind", "target"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "bindingKind": { "enum": ["definition", "alias", "re-export"] },
        "target": { "$ref": "#/$defs/localId" },
        "conditions": { "$ref": "#/$defs/condition" }
      }
    },
    "importBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "bindings"],
      "properties": {
        "kind": { "const": "import-bindings" },
        "bindings": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/binding" }
        }
      }
    },
    "correspondence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declaration", "runtime", "relation"],
      "properties": {
        "declaration": { "$ref": "#/$defs/localId" },
        "runtime": { "$ref": "#/$defs/localId" },
        "relation": { "enum": ["describes", "augments", "replaces-for-type-checking"] },
        "conditions": { "$ref": "#/$defs/condition" }
      }
    },
    "declarationCorrespondence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "mappings"],
      "properties": {
        "kind": { "const": "declaration-correspondence" },
        "mappings": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/correspondence" }
        }
      }
    }
  }
}
