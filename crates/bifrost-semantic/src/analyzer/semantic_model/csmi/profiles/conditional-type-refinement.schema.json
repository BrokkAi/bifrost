{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csmi.brokk.ai/schema/profiles/conditional-type-refinement/0.1/schema.json",
  "title": "CSMI conditional-type-refinement profile 0.1.0 payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "callable", "subject", "outcome"],
  "properties": {
    "kind": { "const": "conditional-type-refinement" },
    "callable": { "$ref": "#/$defs/localId" },
    "subject": { "$ref": "#/$defs/parameterSubject" },
    "outcome": { "$ref": "#/$defs/outcome" }
  },
  "$defs": {
    "localId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]*$" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "parameterSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "position"],
      "properties": {
        "kind": { "const": "parameter" },
        "position": { "type": "integer", "minimum": 0 }
      }
    },
    "typeExpression": {
      "oneOf": [
        { "$ref": "#/$defs/referenceType" },
        { "$ref": "#/$defs/parameterType" },
        { "$ref": "#/$defs/intrinsicType" }
      ]
    },
    "referenceType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "symbol"],
      "properties": {
        "kind": { "const": "reference" },
        "symbol": { "$ref": "#/$defs/localId" },
        "arguments": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/typeExpression" }
        }
      }
    },
    "parameterType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "symbol"],
      "properties": {
        "kind": { "const": "parameter" },
        "symbol": { "$ref": "#/$defs/localId" }
      }
    },
    "intrinsicType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "vocabulary", "version", "identifier"],
      "properties": {
        "kind": { "const": "intrinsic" },
        "vocabulary": { "type": "string", "pattern": "^(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
        "version": { "$ref": "#/$defs/nonEmptyString" },
        "identifier": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "supported": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "semantics", "target"],
      "properties": {
        "kind": { "const": "supported" },
        "semantics": { "enum": ["biconditional", "positive-only"] },
        "target": { "$ref": "#/$defs/typeExpression" }
      }
    },
    "limitation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["unsupported-target", "conflicting-overloads", "uninterpretable-semantics", "unresolved-identity", "incomplete-input", "other"] },
        "message": { "$ref": "#/$defs/nonEmptyString" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "other" } }, "required": ["kind"] },
          "then": { "required": ["message"] }
        }
      ]
    },
    "closedFailure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "limitation"],
      "properties": {
        "kind": { "enum": ["unsupported", "indeterminate"] },
        "limitation": { "$ref": "#/$defs/limitation" }
      }
    },
    "outcome": {
      "oneOf": [
        { "$ref": "#/$defs/supported" },
        { "$ref": "#/$defs/closedFailure" }
      ]
    }
  }
}
