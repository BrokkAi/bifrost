(endpoint
  :schema-version 1
  :id "bifrost.resources.acquire"
  :name "Resource acquisition"
  :display-name "acquired resource"
  :role source
  :categories [resource.lifecycle resource.acquire]
  :selector
    (rql
      :schema-version 1
      (language typescript
        (call :callee (name "openResource"))))
  :binding return-value
  :supersedes [])
