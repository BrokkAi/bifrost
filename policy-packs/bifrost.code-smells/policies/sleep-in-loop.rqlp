(policy
  :schema-version 1
  :id "bifrost.performance.sleep-in-loop"
  :name "Sleep inside a loop"
  :message "Review whether this lexically nested sleep implements polling"
  :severity note
  :description "A sleep call lexically nested under a loop can indicate polling. This structural prompt also includes deferred nested bodies; verify execution before replacing it with notification or bounded backoff."
  :help-uri "https://bifrost.brokk.ai/static-analysis-policies/#built-in-code-smell-pack"
  :tags ["performance" "polling" "loop" "code-smell"]
  :analysis
    (analysis
      :type match
      :selector
        (rql
          :schema-version 2
          (union
            (language python
              (inside (loop) (call :receiver (name "time") :callee (name "sleep"))))
            (language java
              (inside (loop) (call :receiver (name "Thread") :callee (name "sleep"))))
            (language rust
              (inside (loop) (call :receiver (name "thread") :callee (name "sleep"))))))))
