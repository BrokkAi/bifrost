(policy
  :schema-version 1
  :id "bifrost.performance.sleep-in-loop"
  :name "Sleep inside a loop"
  :message "Replace polling sleep with notification or bounded backoff"
  :severity note
  :description "Sleeping in a loop often indicates polling that delays progress and retains resources. Prefer event-driven notification or document a bounded backoff strategy."
  :help-uri "https://bifrost.brokk.ai/static-analysis-policies/#built-in-code-smell-pack"
  :tags ["performance" "polling" "loop" "code-smell"]
  :analysis
    (analysis
      :type match
      :selector
        (rql
          :schema-version 2
          (union
            (language python
              (inside (loop) (call :receiver (name "time") :callee (name "sleep"))))
            (language java
              (inside (loop) (call :receiver (name "Thread") :callee (name "sleep"))))))))
