(policy
  :schema-version 1
  :id "bifrost.performance.network-call-in-loop"
  :name "Network request inside a loop"
  :message "Batch, prefetch, or bound concurrent network requests"
  :severity warning
  :description "A serial network request per iteration amplifies latency and remote load. Prefer batching or explicit bounded concurrency with backpressure."
  :help-uri "https://bifrost.brokk.ai/static-analysis-policies/#built-in-code-smell-pack"
  :tags ["performance" "network" "loop" "code-smell"]
  :analysis
    (analysis
      :type match
      :selector
        (rql
          :schema-version 2
          (union
            (language python
              (inside (loop) (call :receiver (name "requests") :callee (name "get"))))
            (language python
              (inside (loop) (call :receiver (name "requests") :callee (name "post"))))
            (language java
              (inside (loop) (call :receiver (name "client") :callee (name "send"))))
            (language javascript (inside (loop) (call :callee (name "fetch"))))
            (language typescript (inside (loop) (call :callee (name "fetch"))))))))
