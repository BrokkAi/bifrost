(policy
  :schema-version 1
  :id "bifrost.performance.sort-in-loop"
  :name "Sorting inside a loop"
  :message "Avoid sorting repeatedly inside the loop"
  :severity warning
  :description "Sorting inside a loop multiplies comparison and allocation work. Sort before the loop or maintain the required order incrementally when the input is loop-invariant."
  :help-uri "https://bifrost.brokk.ai/static-analysis-policies/#built-in-code-smell-pack"
  :tags ["performance" "collections" "loop" "code-smell"]
  :analysis
    (analysis
      :type match
      :selector
        (rql
          :schema-version 2
          (union
            (language python (inside (loop) (call :callee (name "sort"))))
            (language java (inside (loop) (call :callee (name "sort"))))
            (language typescript (inside (loop) (call :callee (name "sort"))))))))
