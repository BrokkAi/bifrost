(policy
  :schema-version 1
  :id "bifrost.performance.file-read-in-loop"
  :name "File read inside a loop"
  :message "Review whether this lexically nested file read repeats per iteration"
  :severity warning
  :description "A file-read call lexically nested under a loop may multiply I/O and allocation. This structural prompt also includes deferred nested bodies; verify execution before reading once, streaming, or batching."
  :help-uri "https://bifrost.brokk.ai/static-analysis-policies/#built-in-code-smell-pack"
  :tags ["performance" "io" "loop" "code-smell"]
  :analysis
    (analysis
      :type match
      :selector
        (rql
          :schema-version 2
          (union
            (language python (inside (loop) (call :callee (name "open"))))
            (language java
              (inside (loop) (call :receiver (name "Files") :callee (name "readString"))))
            (language java
              (inside (loop) (call :receiver (name "Files") :callee (name "readAllBytes"))))
            (language javascript
              (inside (loop) (call :receiver (name "fs") :callee (name "readFileSync"))))
            (language typescript
              (inside (loop) (call :receiver (name "fs") :callee (name "readFileSync"))))
            (language rust
              (inside
                (loop)
                (call
                  :receiver (name "fs")
                  :callee (name/regex "^(read|read_to_string)$"))))))))
