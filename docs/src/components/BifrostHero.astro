---
import { LinkButton } from '@astrojs/starlight/components';
import type { StarlightRouteData } from '@astrojs/starlight/route-data';

const { data } = (Astro.locals as { starlightRoute: StarlightRouteData }).starlightRoute.entry;
const { actions = [] } = data.hero || {};

// The beam is one cubic Bézier from lower-left to upper-right, crossing behind
// the console card. Every layer — spectral ribbons, fibers, sparks, the exit
// flare, and the user-space gradients — derives from these four control
// points, so the composition is tuned here and nowhere else.
const A = { x: 6, y: 667 };
const B = { x: 435, y: 558 };
const C = { x: 845, y: 360 };
const D = { x: 1434, y: 62 };

const beamArc = `M ${A.x} ${A.y} C ${B.x} ${B.y}, ${C.x} ${C.y}, ${D.x} ${D.y}`;

const cubicPoint = (t: number) => {
	const u = 1 - t;
	return {
		x: u ** 3 * A.x + 3 * u ** 2 * t * B.x + 3 * u * t ** 2 * C.x + t ** 3 * D.x,
		y: u ** 3 * A.y + 3 * u ** 2 * t * B.y + 3 * u * t ** 2 * C.y + t ** 3 * D.y,
	};
};

const cubicTangent = (t: number) => {
	const u = 1 - t;
	return {
		x: 3 * u ** 2 * (B.x - A.x) + 6 * u * t * (C.x - B.x) + 3 * t ** 2 * (D.x - C.x),
		y: 3 * u ** 2 * (B.y - A.y) + 6 * u * t * (C.y - B.y) + 3 * t ** 2 * (D.y - C.y),
	};
};

// The spectrum gradients live in user space, perpendicular to the arc where it
// crosses the console card: warm fringe up-left, cool fringe down-right.
const anchor = cubicPoint(0.71);
const anchorTangent = cubicTangent(0.71);
const anchorLength = Math.hypot(anchorTangent.x, anchorTangent.y);
const normal = { x: -anchorTangent.y / anchorLength, y: anchorTangent.x / anchorLength };

const spectrumBand = (halfWidth: number) => ({
	x1: (anchor.x - normal.x * halfWidth).toFixed(1),
	y1: (anchor.y - normal.y * halfWidth).toFixed(1),
	x2: (anchor.x + normal.x * halfWidth).toFixed(1),
	y2: (anchor.y + normal.y * halfWidth).toFixed(1),
});

const auraBand = spectrumBand(150);
const haloBand = spectrumBand(68);
const bodyBand = spectrumBand(26);

const rampFrom = cubicPoint(0.5);
const rampTo = cubicPoint(0.98);

// Spectral fibers ride the same arc shifted along the beam normal, so each hue
// holds its own track across the ribbon.
const fibers = [
	{ k: 21, color: '#ff4a2d', width: 2.6, dash: 150, gap: 940, dur: '8.4s', delay: '-1.2s', opacity: 0.6 },
	{ k: 12, color: '#ff9438', width: 2.3, dash: 110, gap: 820, dur: '6.8s', delay: '-3.4s', opacity: 0.65 },
	{ k: 5, color: '#ffd76a', width: 2.0, dash: 80, gap: 700, dur: '5.6s', delay: '-0.8s', opacity: 0.7 },
	{ k: -4, color: '#7df0cf', width: 2.0, dash: 95, gap: 760, dur: '6.1s', delay: '-2.6s', opacity: 0.65 },
	{ k: -11, color: '#55b6ff', width: 2.3, dash: 120, gap: 860, dur: '7.2s', delay: '-4.5s', opacity: 0.6 },
	{ k: -19, color: '#8f6bff', width: 2.6, dash: 140, gap: 920, dur: '8.9s', delay: '-1.9s', opacity: 0.55 },
].map((f) => ({ ...f, dx: (-f.k * normal.x).toFixed(1), dy: (-f.k * normal.y).toFixed(1) }));

// Two brighter threads with slightly perturbed control points for organic wobble.
const threads = [
	{ d: `M ${A.x} ${A.y + 4} C ${B.x + 2} ${B.y + 6}, ${C.x + 2} ${C.y - 6}, ${D.x} ${D.y + 4}`, color: '#ffe9a8', width: 1.2, dash: 60, gap: 520, dur: '4.8s', delay: '-2.2s', opacity: 0.7 },
	{ d: `M ${A.x} ${A.y - 4} C ${B.x - 2} ${B.y - 6}, ${C.x - 2} ${C.y + 6}, ${D.x} ${D.y - 4}`, color: '#9fd8ff', width: 1.2, dash: 70, gap: 560, dur: '5.3s', delay: '-0.4s', opacity: 0.65 },
];

// Embers that drift along the beam direction and fade.
const sparkDrift = (() => {
	const tangent = cubicTangent(0.75);
	const length = Math.hypot(tangent.x, tangent.y);
	return { x: `${((tangent.x / length) * 42).toFixed(1)}px`, y: `${((tangent.y / length) * 42).toFixed(1)}px` };
})();

const sparks = [
	{ t: 0.55, r: 2.2, dur: '3.6s', delay: '-0.6s' },
	{ t: 0.65, r: 1.7, dur: '4.2s', delay: '-2.1s' },
	{ t: 0.75, r: 2.6, dur: '3.2s', delay: '-1.4s' },
	{ t: 0.85, r: 1.8, dur: '4.7s', delay: '-3.3s' },
	{ t: 0.92, r: 2.3, dur: '3.9s', delay: '-2.8s' },
].map((s) => {
	const p = cubicPoint(s.t);
	return { ...s, x: p.x.toFixed(1), y: p.y.toFixed(1) };
});

// The exit flare sits on the arc near the right edge so it crops with the beam
// at every viewport width instead of being positioned against the hero box.
const flarePoint = cubicPoint(0.9);
const flareTangent = cubicTangent(0.9);
const flareAngle = ((Math.atan2(flareTangent.y, flareTangent.x) * 180) / Math.PI).toFixed(1);

// Deterministic starfield so every build renders the same sky.
function mulberry32(seed: number) {
	return () => {
		seed |= 0;
		seed = (seed + 0x6d2b79f5) | 0;
		let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
		t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
		return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
	};
}

const rand = mulberry32(1408);
const tints = ['#f4f1ec', '#f4f1ec', '#ffe3c2', '#cfe0ff'];
const stars = Array.from({ length: 46 }, () => ({
	x: Math.round(rand() * 1440),
	y: Math.round(rand() * 700),
	r: (0.5 + rand() * 1.2).toFixed(2),
	o: (0.1 + rand() * 0.3).toFixed(2),
	tint: tints[Math.floor(rand() * tints.length)],
	twinkles: rand() < 0.45,
	dur: `${(3.5 + rand() * 4).toFixed(2)}s`,
	delay: `${(-rand() * 6).toFixed(2)}s`,
}));

// The beam is split across two sibling layers so the browser can cache the
// expensive one. Everything blurred is static and rasterizes exactly once;
// everything that moves is filter-free and repaints cheaply. Mixing the two —
// as a single SVG does — makes every animation frame re-run every Gaussian
// blur across the whole viewport, which is what made this hero crawl.
const staticStars = stars.filter((s) => !s.twinkles);
const liveStars = stars.filter((s) => s.twinkles);
---

<div class="beam-wrap" aria-hidden="true" data-beam-wrap>
		<svg class="beam-layer beam-layer--static" viewBox="0 0 1440 720" preserveAspectRatio="xMidYMid slice">
			<defs>
			<linearGradient id="beam-spectrum-aura" gradientUnits="userSpaceOnUse" x1={auraBand.x1} y1={auraBand.y1} x2={auraBand.x2} y2={auraBand.y2}>
				<stop offset="0" stop-color="#ff3b2c" stop-opacity="0" />
				<stop offset="0.1" stop-color="#ff5a33" stop-opacity="0.65" />
				<stop offset="0.22" stop-color="#ff9a3c" stop-opacity="0.85" />
				<stop offset="0.36" stop-color="#ffd975" />
				<stop offset="0.47" stop-color="#fffdf4" />
				<stop offset="0.58" stop-color="#8ff0d8" />
				<stop offset="0.74" stop-color="#4fa8ff" stop-opacity="0.95" />
				<stop offset="0.9" stop-color="#8a63ff" stop-opacity="0.75" />
				<stop offset="1" stop-color="#8a63ff" stop-opacity="0" />
			</linearGradient>
			<linearGradient id="beam-spectrum-halo" gradientUnits="userSpaceOnUse" x1={haloBand.x1} y1={haloBand.y1} x2={haloBand.x2} y2={haloBand.y2}>
				<stop offset="0" stop-color="#ff3b2c" stop-opacity="0" />
				<stop offset="0.1" stop-color="#ff5a33" stop-opacity="0.65" />
				<stop offset="0.22" stop-color="#ff9a3c" stop-opacity="0.85" />
				<stop offset="0.36" stop-color="#ffd975" />
				<stop offset="0.47" stop-color="#fffdf4" />
				<stop offset="0.58" stop-color="#8ff0d8" />
				<stop offset="0.74" stop-color="#4fa8ff" stop-opacity="0.95" />
				<stop offset="0.9" stop-color="#8a63ff" stop-opacity="0.75" />
				<stop offset="1" stop-color="#8a63ff" stop-opacity="0" />
			</linearGradient>
				<linearGradient id="beam-spectrum-body" gradientUnits="userSpaceOnUse" x1={bodyBand.x1} y1={bodyBand.y1} x2={bodyBand.x2} y2={bodyBand.y2}>
					<stop offset="0" stop-color="#ff3b2c" stop-opacity="0" />
					<stop offset="0.08" stop-color="#ff5a33" stop-opacity="0.75" />
					<stop offset="0.24" stop-color="#ff9a3c" stop-opacity="0.95" />
					<stop offset="0.38" stop-color="#ffd975" />
					<stop offset="0.5" stop-color="#fffdf4" />
					<stop offset="0.62" stop-color="#8ff0d8" />
					<stop offset="0.76" stop-color="#4fa8ff" stop-opacity="0.95" />
					<stop offset="0.92" stop-color="#8a63ff" stop-opacity="0.75" />
					<stop offset="1" stop-color="#8a63ff" stop-opacity="0" />
				</linearGradient>
				<linearGradient id="beam-ramp-gradient" gradientUnits="userSpaceOnUse" x1={rampFrom.x} y1={rampFrom.y} x2={rampTo.x} y2={rampTo.y}>
					<stop offset="0" stop-color="#fff3d9" stop-opacity="0" />
					<stop offset="0.55" stop-color="#fff3d9" stop-opacity="0" />
					<stop offset="0.82" stop-color="#ffe9bd" stop-opacity="0.3" />
					<stop offset="1" stop-color="#fffdf4" stop-opacity="0.75" />
				</linearGradient>
				<linearGradient id="beam-entry" x1="0" y1="0" x2="1" y2="0">
					<stop offset="0" stop-color="black" />
					<stop offset="0.2" stop-color="black" />
					<stop offset="0.46" stop-color="white" />
					<stop offset="1" stop-color="white" />
				</linearGradient>
				<mask id="beam-entry-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="1440" height="720">
					<rect width="1440" height="720" fill="url(#beam-entry)" />
				</mask>
				<!-- Filter regions are sized to half the stroke plus the blur's ~3σ
				     spread and no further. The old uniform -40%/-80%/180%/260% box
				     rasterised roughly 4M pixels per pass, most of it empty. -->
				<filter id="beam-blur-xl" x="-20%" y="-50%" width="140%" height="200%">
					<feGaussianBlur stdDeviation="30" />
				</filter>
				<filter id="beam-blur-lg" x="-12%" y="-25%" width="124%" height="150%">
					<feGaussianBlur stdDeviation="13" />
				</filter>
				<filter id="beam-blur-sm" x="-5%" y="-12%" width="110%" height="124%">
					<feGaussianBlur stdDeviation="1.6" />
				</filter>
			<filter id="core-glow" x="-5%" y="-12%" width="110%" height="124%">
				<feGaussianBlur stdDeviation="4" result="blur" />
				<feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
			</filter>
			<radialGradient id="flare-glow">
				<stop offset="0" stop-color="#fffdf4" stop-opacity="0.75" />
				<stop offset="0.24" stop-color="#ffe9bd" stop-opacity="0.32" />
				<stop offset="0.52" stop-color="#ffb27a" stop-opacity="0.1" />
				<stop offset="1" stop-color="#ffb27a" stop-opacity="0" />
			</radialGradient>
			<!-- The flare's hot centre was a solid disc pushed through a Gaussian
			     blur. Baking the same falloff into a gradient costs no filter pass,
			     which lets the flare animate on the cheap live layer. -->
			<radialGradient id="flare-core">
				<stop offset="0" stop-color="#fffdf4" stop-opacity="0.92" />
				<stop offset="0.34" stop-color="#fffdf4" stop-opacity="0.6" />
				<stop offset="0.68" stop-color="#fffdf4" stop-opacity="0.16" />
				<stop offset="1" stop-color="#fffdf4" stop-opacity="0" />
			</radialGradient>
		</defs>

			<g class="starfield">
				{
					staticStars.map((s) => (
						<circle class="star" cx={s.x} cy={s.y} r={s.r} fill={s.tint} style={`--o:${s.o}`} />
					))
				}
			</g>

			<g class="beam" mask="url(#beam-entry-mask)">
				<path class="beam-aura" d={beamArc} fill="none" stroke="url(#beam-spectrum-aura)" stroke-width="300" filter="url(#beam-blur-xl)" />
				<path class="beam-halo" d={beamArc} fill="none" stroke="url(#beam-spectrum-halo)" stroke-width="130" filter="url(#beam-blur-lg)" />
				<path class="beam-ramp" d={beamArc} fill="none" stroke="url(#beam-ramp-gradient)" stroke-width="90" filter="url(#beam-blur-lg)" />
				<path class="beam-body" d={beamArc} fill="none" stroke="url(#beam-spectrum-body)" stroke-width="46" filter="url(#beam-blur-sm)" />
				<path class="beam-core-soft" d={beamArc} fill="none" stroke="#ffffff" stroke-width="20" opacity="0.22" filter="url(#beam-blur-lg)" />
				<path class="beam-core" d={beamArc} fill="none" stroke="#fff8ea" stroke-width="6" opacity="0.82" filter="url(#core-glow)" />
			</g>
	</svg>

	<svg class="beam-layer beam-layer--live" viewBox="0 0 1440 720" preserveAspectRatio="xMidYMid slice">
			<g class="starfield">
				{
					liveStars.map((s) => (
						<circle
							class="star twinkle"
							cx={s.x}
							cy={s.y}
							r={s.r}
							fill={s.tint}
							style={`--o:${s.o};--dur:${s.dur};--delay:${s.delay}`}
						/>
					))
				}
			</g>

			<g>
				{
					fibers.map((f) => (
						<path
							class="beam-fiber"
							d={beamArc}
							stroke={f.color}
							stroke-width={f.width}
							stroke-dasharray={`${f.dash} ${f.gap}`}
							opacity={f.opacity}
							transform={`translate(${f.dx} ${f.dy})`}
							style={`--dur:${f.dur};--delay:${f.delay};--cycle:${f.dash + f.gap}`}
						/>
					))
				}
				{
					threads.map((t) => (
						<path
							class="beam-fiber"
							d={t.d}
							stroke={t.color}
							stroke-width={t.width}
							stroke-dasharray={`${t.dash} ${t.gap}`}
							opacity={t.opacity}
							style={`--dur:${t.dur};--delay:${t.delay};--cycle:${t.dash + t.gap}`}
						/>
					))
				}
				<path class="beam-core-pulse" d={beamArc} fill="none" stroke="#fff8ea" stroke-width="6" />
			</g>

			<g>
				{
					sparks.map((s) => (
						<circle
							class="beam-spark"
							cx={s.x}
							cy={s.y}
							r={s.r}
							fill="#fff8ea"
							style={`--dur:${s.dur};--delay:${s.delay};--dx:${sparkDrift.x};--dy:${sparkDrift.y}`}
						/>
					))
				}
			</g>

			<g transform={`translate(${flarePoint.x.toFixed(1)} ${flarePoint.y.toFixed(1)})`}>
				<g class="exit-flare">
					<circle r="200" fill="url(#flare-glow)" />
					<ellipse rx="230" ry="10" fill="url(#flare-glow)" opacity="0.8" transform={`rotate(${flareAngle})`} />
					<circle r="72" fill="url(#flare-core)" />
				</g>
			</g>
	</svg>
</div>

<script is:inline>
	// The beam is a page-level backdrop: hoist it out of the constrained content
	// column so it spans the full viewport width from the very top of the page.
	// Structural move only — no measurement. Runs inline to avoid a first-paint flash.
	const beamWrap = document.querySelector('[data-beam-wrap]');
	if (beamWrap && beamWrap.parentElement !== document.body) {
		document.body.prepend(beamWrap);
	}
</script>

<section class="bifrost-hero" aria-labelledby="_top">
	<div class="hero-copy">
		<p class="hero-eyebrow">
			<span></span> Bifrost by <a href="https://brokk.ai" rel="external">Brokk</a>
		</p>
		<h1
			id="_top"
			data-page-title
			aria-label="Code intelligence for AI, developers, researchers, security teams, and tool builders."
		>
			Code intelligence
			<em><span class="hero-audience" data-hero-audience aria-hidden="true">for AI.</span></em>
		</h1>
		<p class="hero-tagline">
			Give agents and teams a structured model of the repository instead of another pile of text.
			Query symbols, trace usage graphs, enforce structural policies, and analyze large multi-language
			codebases locally.
		</p>
		{
			actions.length > 0 && (
				<div class="hero-actions">
					{actions.map(
						({ icon, link: href, text, variant }) => (
							<LinkButton href={href} variant={variant} icon={icon?.name}>
								{text}
								{icon?.html && <Fragment set:html={icon.html} />}
							</LinkButton>
						)
					)}
				</div>
			)
		}

		<section class="install-strip" aria-labelledby="install-bifrost">
			<div class="install-strip__heading">
				<p id="install-bifrost">Install Bifrost</p>
				<div role="tablist" aria-label="Installation methods">
					<button id="install-curl-tab" type="button" role="tab" aria-selected="true" aria-controls="install-curl-panel" tabindex="0">
						curl
					</button>
					<button id="install-homebrew-tab" type="button" role="tab" aria-selected="false" aria-controls="install-homebrew-panel" tabindex="-1">
						Homebrew
					</button>
					<button id="install-uv-tab" type="button" role="tab" aria-selected="false" aria-controls="install-uv-panel" tabindex="-1">
						uv
					</button>
					<button id="install-npx-tab" type="button" role="tab" aria-selected="false" aria-controls="install-npx-panel" tabindex="-1">
						npx
					</button>
				</div>
			</div>
			<div id="install-curl-panel" class="install-strip__command" role="tabpanel" aria-labelledby="install-curl-tab">
				<code title="curl -fsSL https://raw.githubusercontent.com/BrokkAi/bifrost/refs/heads/master/install.sh | bash">curl -fsSL https://raw.githubusercontent.com/BrokkAi/bifrost/refs/heads/master/install.sh | bash</code>
				<button type="button" data-install-copy aria-label="Copy installation command">Copy</button>
			</div>
			<div id="install-homebrew-panel" class="install-strip__command" role="tabpanel" aria-labelledby="install-homebrew-tab" hidden>
				<code title="brew install brokkai/tap/bifrost">brew install brokkai/tap/bifrost</code>
				<button type="button" data-install-copy aria-label="Copy installation command">Copy</button>
			</div>
			<div id="install-uv-panel" class="install-strip__command" role="tabpanel" aria-labelledby="install-uv-tab" hidden>
				<code title="uv tool install brokk-bifrost">uv tool install brokk-bifrost</code>
				<button type="button" data-install-copy aria-label="Copy installation command">Copy</button>
			</div>
			<div id="install-npx-panel" class="install-strip__command" role="tabpanel" aria-labelledby="install-npx-tab" hidden>
				<code title="npx -y @brokkai/bifrost">npx -y @brokkai/bifrost</code>
				<button type="button" data-install-copy aria-label="Copy installation command">Copy</button>
			</div>
		</section>

		<ul class="hero-proof" aria-label="Core capabilities">
			<li><span>01</span><strong>Structural queries</strong><small>AST-aware matching</small></li>
			<li><span>02</span><strong>Usage graphs</strong><small>Definitions to call sites</small></li>
			<li><span>03</span><strong>Repository scale</strong><small>Multi-language context</small></li>
		</ul>
	</div>

	<div class="query-console bifrost-panel bifrost-panel--reverse" aria-hidden="true">
		<div class="console-topline">WHAT IS CODE INTELLIGENCE?</div>
		<p class="console-brief">
			One structured model of the whole repository — symbols, references, and call edges
			resolved across files, never text matching.
		</p>
		<div class="console-spec">
			<span>LANGUAGES</span>
			<small>PYTHON · JAVA · JS · TS · GO · C · C++ · RUST · PHP · SCALA · C# · RUBY · KOTLIN</small>
		</div>
		<div class="console-spec">
			<span>INTERFACES</span>
			<small>MCP · LSP · CLI · PYTHON · RUST</small>
		</div>
	</div>
</section>

<script>
	const audiences = [
		'for AI.',
		'for developers.',
		'for researchers.',
		'for security teams.',
		'for tool builders.',
	];

	function startAudienceRotation() {
		const audience = document.querySelector<HTMLElement>('[data-hero-audience]');
		if (
			!audience ||
			audience.dataset.rotationStarted ||
			window.matchMedia('(prefers-reduced-motion: reduce)').matches
		) {
			return;
		}

		audience.dataset.rotationStarted = 'true';
		let audienceIndex = 0;
		const interval = window.setInterval(() => {
			if (!audience.isConnected) {
				window.clearInterval(interval);
				return;
			}
			if (document.hidden) return;

			audience.classList.add('is-changing');
			window.setTimeout(() => {
				if (!audience.isConnected) return;
				audienceIndex = (audienceIndex + 1) % audiences.length;
				const nextAudience = audiences[audienceIndex];
				audience.textContent = nextAudience;
				audience.classList.remove('is-changing');
			}, 180);
		}, 3600);
	}

	startAudienceRotation();
	document.addEventListener('astro:page-load', startAudienceRotation);

	function startInstallControls() {
		const tablist = document.querySelector<HTMLElement>('.install-strip [role="tablist"]');
		if (!tablist || tablist.dataset.controlsStarted) return;

		tablist.dataset.controlsStarted = 'true';
		const tabs = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
		const selectTab = (selectedTab: HTMLButtonElement) => {
			for (const tab of tabs) {
				const selected = tab === selectedTab;
				tab.setAttribute('aria-selected', String(selected));
				tab.tabIndex = selected ? 0 : -1;
				const panelId = tab.getAttribute('aria-controls');
				const panel = panelId ? document.getElementById(panelId) : null;
				if (panel) panel.hidden = !selected;
			}
		};

		tabs.forEach((tab, index) => {
			tab.addEventListener('click', () => selectTab(tab));
			tab.addEventListener('keydown', (event) => {
				if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
				event.preventDefault();
				const offset = event.key === 'ArrowRight' ? 1 : -1;
				const nextTab = tabs[(index + offset + tabs.length) % tabs.length];
