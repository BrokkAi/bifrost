---
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro';
import Search from '@astrojs/starlight/components/Search.astro';
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
import SocialIcons from '@astrojs/starlight/components/SocialIcons.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
import type { StarlightRouteData } from '@astrojs/starlight/route-data';

const { siteTitleHref } = (Astro.locals as { starlightRoute: StarlightRouteData }).starlightRoute;
const root = siteTitleHref.endsWith('/') ? siteTitleHref : `${siteTitleHref}/`;
const navItems = [
	{ label: 'Overview', slug: 'overview/' },
	{ label: 'Capabilities', slug: 'capabilities/' },
	{ label: 'MCP', slug: 'mcp/' },
	{ label: 'LSP', slug: 'lsp/' },
	{ label: 'Querying', slug: 'code-querying/' },
];
const currentPath = Astro.url.pathname.replace(/\/+$/, '/');
---

<div class="bifrost-header-shell bifrost-panel bifrost-panel--octagon">
	<div class="bifrost-brand sl-flex">
		<span class="brand-signal" aria-hidden="true"><i></i><i></i><i></i></span>
		<SiteTitle />
		<a
			class="license-invite bifrost-panel bifrost-panel--sm"
			href={`${root}license-use-cases/`}
			aria-label="Free to use under LGPL-3.0-or-later. See license and use cases."
		>
			<span>Free to use</span>
			<small>LGPL-3</small>
		</a>
	</div>
	<nav class="bifrost-primary-nav print:hidden" aria-label="Primary">
		{
			navItems.map(({ label, slug }) => {
				const href = `${root}${slug}`;
				return (
					<a href={href} aria-current={currentPath === href ? 'page' : undefined}>
						{label}
					</a>
				);
			})
		}
	</nav>
	<div class="bifrost-header-search sl-flex print:hidden"><Search /></div>
	<div class="bifrost-header-tools sl-hidden md:sl-flex print:hidden">
		<div class="sl-flex social-icons"><SocialIcons /></div>
		<ThemeSelect />
		<LanguageSelect />
	</div>
</div>

<style>
	@layer starlight.user {
		.bifrost-header-shell {
			display: grid;
			grid-template-columns: auto minmax(8rem, 22rem) auto;
			align-items: center;
			gap: clamp(0.65rem, 1.5vw, var(--bifrost-space-5));
			height: 100%;
			max-width: 92rem;
			margin-inline: auto;
			padding: var(--bifrost-space-2) var(--bifrost-space-6);
		}

		.bifrost-header-shell::after {
			/* No backdrop-filter here. The header is sticky over the animated beam,
			   so a live backdrop blur re-sampled and re-blurred the moving artwork
			   beneath it on every frame. Over a near-black backdrop an opaque fill
			   is visually equivalent and costs nothing. */
			background:
				linear-gradient(180deg, rgb(255 255 255 / 0.055), transparent),
				rgb(9 9 9 / 0.97);
			box-shadow:
				0 18px 42px rgb(0 0 0 / 0.34),
				inset 0 1px rgb(255 255 255 / 0.025);
		}

		.bifrost-brand {
			align-items: center;
			gap: var(--bifrost-space-3);
			min-width: 0;
		}

		.brand-signal {
			display: grid;
			flex: 0 0 1.3rem;
			width: 1.3rem;
			height: 1.3rem;
			place-items: center;
		}

		.brand-signal i {
			position: absolute;
			width: 0.68rem;
			height: 0.68rem;
			border: 1px solid #f4f1ec;
			transform: rotate(45deg);
		}

		.brand-signal i:nth-child(1) {
			transform: translate(-0.32rem, 0.25rem) rotate(45deg);
			opacity: 0.38;
		}

		.brand-signal i:nth-child(2) {
			border-color: #eb3f33;
			box-shadow: 0 0 12px rgb(235 63 51 / 0.56);
		}

		.brand-signal i:nth-child(3) {
			transform: translate(0.32rem, -0.25rem) rotate(45deg);
			opacity: 0.62;
		}

		.bifrost-brand :global(.site-title) {
			color: #f4f1ec;
			font-family: var(--bifrost-font-display);
			font-size: 1.375rem;
			font-weight: var(--bifrost-weight-regular);
			letter-spacing: var(--bifrost-tracking-wide);
			line-height: 1;
			text-transform: uppercase;
			transform: translateY(0.0625rem);
		}

		.bifrost-primary-nav {
			display: none;
			align-items: center;
			justify-content: center;
			gap: var(--bifrost-space-2);
		}

		.bifrost-primary-nav a {
			position: relative;
			padding: var(--bifrost-space-2) var(--bifrost-space-3);
			color: #948b7e;
			font-family: var(--bifrost-font-mono);
			font-size: var(--bifrost-text-xs);
			font-weight: var(--bifrost-weight-semibold);
			letter-spacing: var(--bifrost-tracking-widest);
			text-decoration: none;
			text-transform: uppercase;
			transition: color 140ms ease;
		}

		.bifrost-primary-nav a::after {
			position: absolute;
			inset-inline: 0.65rem;
			inset-block-end: 0.24rem;
			height: 1px;
			background: #eb3f33;
			box-shadow: 0 0 8px #eb3f33;
			content: '';
			transform: scaleX(0);
			transition: transform 140ms ease;
		}

		.bifrost-primary-nav a:hover,
		.bifrost-primary-nav a:focus-visible,
		.bifrost-primary-nav a[aria-current='page'] {
			color: #f4f1ec;
		}

		.bifrost-primary-nav a[aria-current='page']::after {
			transform: scaleX(1);
		}

		.bifrost-header-search {
			justify-self: end;
			width: clamp(11rem, 16vw, 20rem);
			min-width: 0;
		}
		.bifrost-header-search :global(button[data-open-modal]) { max-width: none; }

		.bifrost-header-tools {
			align-items: center;
			gap: var(--bifrost-space-3);
		}

		.bifrost-header-tools :global(starlight-theme-select select) {
			padding-inline-start: calc(var(--sl-label-icon-size) + var(--sl-inline-padding) + 0.375rem);
		}

		/* A quiet chip, not a call to action. The red wash, red border, red
		   diamond and red arrow all competed with the nav for a link that is
		   really just a footnote about licensing, so the resting state is now
		   the same neutral surface as the rest of the header chrome and red is
		   held back for hover. */
		/* Uses the shared two-layer panel rather than a border plus clip-path.
		   A clip-path cuts the border it is supposed to be drawing, which is why
		   the bottom-left and top-right diagonals and the right edge were
		   missing: the border was painted on the box, then the chamfer sliced it
		   off. The panel paints the edge as a clipped fill with a second, one
		   pixel smaller fill on top, so every side and both diagonals are
		   continuous. On .bifrost-panel the element's own background IS the
		   border colour and ::after is the face. */
		.license-invite {
			display: none;
			/* Sits beside the wordmark now, so it must not absorb the brand
			   column's shrinking. */
			flex: none;
			align-items: baseline;
			gap: var(--bifrost-space-2);
			padding: var(--bifrost-space-2) var(--bifrost-space-3);
			font-family: var(--bifrost-font-mono);
			line-height: 1;
			text-decoration: none;
			white-space: nowrap;
			transition: background-color 150ms ease;
		}

		.license-invite::after {
			background: var(--bifrost-surface-raised);
			transition: background-color 150ms ease;
		}

		.license-invite span {
			color: #f4f1ec;
			font-size: var(--bifrost-text-xs);
			font-weight: var(--bifrost-weight-semibold);
			letter-spacing: var(--bifrost-tracking-wide);
		}

		/* No divider rule between the two: the weight, size and colour shift
		   already separate them, and the bar was a third ornament in a chip
		   carrying two words. */
		.license-invite small {
			color: #948b7e;
			font-size: var(--bifrost-text-2xs);
			letter-spacing: var(--bifrost-tracking-wide);
			transition: color 150ms ease;
		}

		/* Outer background is the edge, ::after is the face. */
		.license-invite:hover,
		.license-invite:focus-visible {
			background: rgb(255 106 95 / 0.55);
		}

		.license-invite:hover::after,
		.license-invite:focus-visible::after {
			background: color-mix(in srgb, #eb3f33 12%, var(--bifrost-surface-raised));
		}

		.license-invite:hover small,
		.license-invite:focus-visible small {
			color: #ff6a5f;
		}

		.social-icons {
			align-items: center;
			gap: var(--bifrost-space-3);
		}

		.social-icons::after {
			width: 1px;
			height: 1.45rem;
			background: rgb(255 255 255 / 0.12);
			content: '';
		}

		@media (width >= 50rem) {
			.bifrost-header-shell {
				grid-template-columns: minmax(11rem, auto) minmax(11rem, 22rem) auto;
			}
		}

		@media (width >= 72rem) {
			.bifrost-header-shell {
				grid-template-columns: minmax(11rem, auto) minmax(0, 1fr) auto auto;
			}

			.bifrost-primary-nav {
				display: flex;
			}

		}

		@media (width >= 84rem) {
			.license-invite { display: inline-flex; }
		}

		@media (width < 50rem) {
			.bifrost-header-shell {
				grid-template-columns: minmax(0, 1fr) auto;
			}
			.bifrost-header-search { width: auto; }
		}

		@media (prefers-reduced-motion: reduce) {
			.license-invite,
			.license-invite small {
				transition: none;
			}
		}
	}
</style>
