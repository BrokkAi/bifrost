            "kind": {
              "type": "string",
              "const": "declaration"
            },
            "name": {
              "$ref": "#/$defs/TemplateExpression"
            },
            "owner": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TemplateExpression"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TemplateTypeRef"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "kind",
            "id",
            "name",
            "declaration_kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "from": {
              "$ref": "#/$defs/TemplateExpression"
            },
            "id": {
              "$ref": "#/$defs/TemplateExpression"
            },
            "kind": {
              "type": "string",
              "const": "alias"
            },
            "to": {
              "$ref": "#/$defs/TemplateExpression"
            }
          },
          "required": [
            "kind",
            "id",
            "from",
            "to"
          ]
        },
        {
          "type": "object",
          "properties": {
            "from": {
              "$ref": "#/$defs/TemplateExpression"
            },
            "id": {
              "$ref": "#/$defs/TemplateExpression"
            },
            "kind": {
              "type": "string",
              "const": "relation"
            },
            "relation_kind": {
              "$ref": "#/$defs/RelationKind"
            },
            "to": {
              "$ref": "#/$defs/TemplateExpression"
            }
          },
          "required": [
            "kind",
            "id",
            "relation_kind",
            "from",
            "to"
          ]
        }
      ]
    },
    "RuleTrigger": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "construct": {
              "type": "string"
