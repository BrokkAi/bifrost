      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type_kind",
        "locator"
      ]
    },
    "TypeKind": {
      "type": "string",
      "enum": [
        "class",
        "interface",
        "trait",
        "struct",
        "enum",
        "record",
        "module",
        "type_alias"
      ]
    },
    "TypeRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "arguments": {
              "type": "array",
              "default": [],
              "items": {
                "$ref": "#/$defs/TypeRef"
              }
            },
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "named"
            },
            "nullable": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "kind",
