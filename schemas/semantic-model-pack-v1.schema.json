{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthoredSemanticModelPack",
  "type": "object",
  "properties": {
    "compatibility": {
      "$ref": "#/$defs/Compatibility"
    },
    "completeness": {
      "$ref": "#/$defs/Completeness"
    },
    "ecosystem": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "pack_id": {
      "type": "string"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "provenance": {
      "$ref": "#/$defs/Provenance"
    },
    "safety": {
      "$ref": "#/$defs/Safety"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "shards": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AuthoredShard"
      }
    },
    "version": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "version",
    "producer",
    "language",
    "ecosystem",
    "compatibility",
    "provenance",
    "license",
    "completeness",
    "safety",
    "shards"
