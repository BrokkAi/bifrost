          ]
        },
        "source": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "source"
      ]
    },
    "RelationFact": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "relation_kind": {
          "$ref": "#/$defs/RelationKind"
        },
        "to": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "relation_kind",
        "from",
        "to"
      ]
    },
    "RelationKind": {
      "type": "string",
      "enum": [
        "owns",
        "extends",
        "implements",
        "aliases",
        "navigates_to",
        "references"
      ]
    },
    "RuleEmission": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "declaration_kind": {
              "$ref": "#/$defs/EmittedDeclarationKind"
