            "kind": {
              "type": "string",
              "const": "language_construct"
            }
          },
          "required": [
            "kind",
            "construct"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "annotation"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "macro_invocation"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "generator_invocation"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "resolved_owner"
            },
            "owner": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "owner"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "resolved_call"
            },
            "name": {
              "type": "string"
            },
            "owner": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "owner",
            "name"
          ]
        }
      ]
    },
    "Safety": {
      "type": "object",
      "properties": {
        "generated_code_only": {
          "type": "boolean",
          "default": false
        },
        "review_required": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "Signature": {
      "type": "object",
      "properties": {
        "parameters": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/Parameter"
          }
        },
        "returns": {
          "anyOf": [
            {
              "$ref": "#/$defs/TypeRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "type_parameters": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "TemplateExpression": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "literal"
            },
            "value": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "op": {
              "type": "string",
              "const": "capture"
            }
          },
          "required": [
            "op",
            "name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "concat"
            },
            "values": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TemplateExpression"
              }
            }
          },
          "required": [
            "op",
            "values"
          ]
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "transform"
            },
            "transform": {
              "$ref": "#/$defs/AsciiTransform"
            },
            "value": {
              "$ref": "#/$defs/TemplateExpression"
            }
          },
          "required": [
            "op",
            "transform",
            "value"
          ]
        }
      ]
    },
    "TemplateTypeRef": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "arguments": {
              "type": "array",
              "default": [],
              "items": {
                "$ref": "#/$defs/TemplateTypeRef"
              }
            },
            "kind": {
              "type": "string",
              "const": "named"
            },
            "name": {
              "$ref": "#/$defs/TemplateExpression"
            },
            "nullable": {
              "type": "boolean",
              "default": false
            }
          },
          "required": [
            "kind",
            "name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "capture"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "element": {
              "$ref": "#/$defs/TemplateTypeRef"
            },
            "kind": {
              "type": "string",
              "const": "array"
            }
          },
          "required": [
            "kind",
            "element"
          ]
        }
      ]
    },
    "TypeFact": {
      "type": "object",
      "properties": {
        "aliases": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "extension_surfaces": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        },
        "name": {
          "type": "string"
        },
        "supertypes": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/TypeRef"
          }
        },
        "type_kind": {
          "$ref": "#/$defs/TypeKind"
        },
        "type_parameters": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
