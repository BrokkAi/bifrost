          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "type_parameter"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "element": {
              "$ref": "#/$defs/TypeRef"
            },
            "kind": {
              "type": "string",
              "const": "array"
            }
          },
          "required": [
            "kind",
            "element"
          ]
        },
        {
          "type": "object",
          "properties": {
            "elements": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TypeRef"
              }
            },
            "kind": {
              "type": "string",
              "const": "tuple"
            }
          },
          "required": [
            "kind",
            "elements"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "function"
