    "ActivationSelector": {
      "type": "object",
      "properties": {
        "artifact_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "configurations": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "module": {
          "anyOf": [
            {
              "$ref": "#/$defs/NameSelector"
            },
            {
              "type": "null"
            }
          ]
        },
        "package": {
          "anyOf": [
            {
              "$ref": "#/$defs/NameSelector"
            },
            {
              "type": "null"
            }
          ]
        },
        "targets": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "toolchain": {
          "anyOf": [
            {
              "$ref": "#/$defs/NameSelector"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "AsciiTransform": {
      "type": "string",
      "enum": [
        "lowercase",
        "uppercase",
        "snake_case",
        "kebab_case",
        "pascal_case",
        "camel_case"
      ]
    },
    "AuthoredPayload": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "declaration_facts"
            },
            "members": {
              "type": "array",
              "default": [],
              "items": {
                "$ref": "#/$defs/MemberFact"
              }
            },
            "relations": {
              "type": "array",
              "default": [],
              "items": {
                "$ref": "#/$defs/RelationFact"
              }
            },
            "types": {
              "type": "array",
              "default": [],
              "items": {
                "$ref": "#/$defs/TypeFact"
              }
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "generator_rules"
            },
            "rules": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/GeneratorRule"
              }
            }
          },
          "required": [
            "kind",
            "rules"
          ]
        }
      ]
    },
    "AuthoredShard": {
      "type": "object",
      "properties": {
        "activation": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActivationSelector"
          }
        },
        "id": {
          "type": "string"
        },
        "payload": {
          "$ref": "#/$defs/AuthoredPayload"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "activation",
        "payload"
      ]
    },
    "CaptureCardinality": {
      "type": "string",
      "enum": [
        "one",
        "optional",
        "many"
      ]
    },
    "CaptureDeclaration": {
      "type": "object",
      "properties": {
        "cardinality": {
          "$ref": "#/$defs/CaptureCardinality"
        },
        "name": {
          "type": "string"
        },
        "value_kind": {
          "$ref": "#/$defs/CaptureValueKind"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "value_kind",
        "cardinality"
      ]
    },
    "CaptureValueKind": {
      "type": "string",
      "enum": [
        "identifier",
        "type",
        "string",
        "path"
      ]
    },
    "Compatibility": {
      "type": "object",
      "properties": {
        "bifrost": {
          "type": "string"
        },
        "toolchains": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/VersionConstraint"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "bifrost"
      ]
    },
    "Completeness": {
      "type": "string",
      "enum": [
        "partial",
        "complete"
      ]
    },
    "EmittedDeclarationKind": {
      "type": "string",
      "enum": [
        "type",
        "member"
      ]
    },
    "GeneratorRule": {
      "type": "object",
      "properties": {
        "captures": {
          "type": "array",
          "default": [],
          "items": {
            "$ref": "#/$defs/CaptureDeclaration"
          }
        },
        "emissions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RuleEmission"
          }
        },
        "id": {
          "type": "string"
        },
        "trigger": {
          "$ref": "#/$defs/RuleTrigger"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "trigger",
        "emissions"
      ]
    },
    "Locator": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "source"
            },
            "path": {
              "type": "string"
            },
            "symbol": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "artifact"
            },
            "path": {
              "type": "string"
            },
            "symbol": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path",
            "symbol"
          ]
        }
      ]
    },
    "MemberFact": {
      "type": "object",
      "properties": {
        "aliases": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "id": {
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/Locator"
        },
        "member_kind": {
          "$ref": "#/$defs/MemberKind"
        },
        "name": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "signature": {
          "anyOf": [
            {
              "$ref": "#/$defs/Signature"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "owner",
        "name",
        "member_kind",
        "locator"
      ]
    },
    "MemberKind": {
      "type": "string",
      "enum": [
        "constructor",
        "method",
        "function",
        "field",
        "property",
        "constant",
        "event"
      ]
    },
    "NameSelector": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "Parameter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "optional": {
          "type": "boolean",
          "default": false
        },
        "type": {
          "$ref": "#/$defs/TypeRef"
        },
        "variadic": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ]
    },
    "Producer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ]
    },
    "Provenance": {
      "type": "object",
      "properties": {
        "revision": {
          "type": [
            "string",
