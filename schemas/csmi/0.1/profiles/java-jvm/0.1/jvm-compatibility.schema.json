{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://csmi.brokk.ai/schema/profiles/java-jvm/0.1/jvm-compatibility.schema.json",
  "title": "CSMI csmi.jvm-compatibility 0.1 constraint value",
  "description": "Conjunctive compatibility requirements evaluated after artifact matching. Missing comparison evidence yields indeterminate compatibility.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profileVersion", "constraints"],
  "properties": {
    "profileVersion": { "const": "0.1" },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "javaRelease": { "$ref": "#/$defs/integerRange" },
        "classFileMajor": { "$ref": "#/$defs/integerRange" },
        "targetPlatform": { "enum": ["jvm", "android"] },
        "jdkModule": { "type": "string", "pattern": "^[A-Za-z0-9_$]+(?:\\.[A-Za-z0-9_$]+)*$" },
        "jvmVendor": {
          "type": "string",
          "format": "uri",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:"
        },
        "kotlinMetadataVersion": { "$ref": "#/$defs/versionTuple" },
        "scalaBinaryVersion": { "type": "string", "pattern": "^[0-9]+(?:\\.[0-9]+)*$" },
        "multiReleaseSelection": { "type": "integer", "minimum": 8 }
      }
    }
  },
  "$defs": {
    "integerRange": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minimum": { "type": "integer", "minimum": 0 },
        "maximum": { "type": "integer", "minimum": 0 }
      },
      "minProperties": 1
    },
    "versionTuple": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": { "type": "integer", "minimum": 0 }
    }
  }
}
