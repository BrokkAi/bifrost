{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Bifrost Rune Query Language",
  "scopeName": "source.bifrost-rql",
  "patterns": [
    {
      "match": "(^|\\s)(;.*$)",
      "captures": {
        "2": {
          "name": "comment.line.semicolon.bifrost-rql"
        }
      }
    },
    {
      "name": "meta.regex-predicate.bifrost-rql",
      "match": "(\\(|:)(?:\\s*)((?:name|text|parameter-type)/regex)(?:\\s*)(\\\")((?:\\\\.|[^\\\"\\\\])*)(\\\")",
      "captures": {
        "1": {
          "name": "punctuation.section.parens.begin.bifrost-rql"
        },
        "2": {
          "name": "support.function.predicate.bifrost-rql"
        },
        "3": {
          "name": "punctuation.definition.string.begin.bifrost-rql"
        },
        "4": {
          "name": "string.regexp.bifrost-rql"
        },
        "5": {
          "name": "punctuation.definition.string.end.bifrost-rql"
        }
      }
    },
    {
      "name": "support.constant.unknown-verdict.bifrost-rql",
      "match": "(?<![A-Za-z0-9_-])(?:abstain|warn-unreliable|fail-closed|treat-may-as-finding)(?=[\\s)\\]])"
    },
    {
      "name": "support.constant.aggregate-operation.bifrost-rql",
      "match": "(?<![A-Za-z0-9_-])(?:set-equal|subset)(?=[\\s)\\]])"
    },
    {
      "name": "support.constant.language-family.bifrost-rql",
      "match": "(?<![A-Za-z0-9_-])(?:jvm|js-ts)(?=[\\s)\\]])"
    },
    {
      "name": "string.quoted.double.bifrost-rql",
      "match": "\\\"(?:\\\\.|[^\\\"\\\\])*\\\""
    },
    {
      "name": "punctuation.section.brackets.bifrost-rql",
      "match": "(?:\\((?!\\s*(?:limit|result-detail)\\s)|[)\\[\\]])"
    },
    {
      "name": "meta.typestate-witness-limit.bifrost-rql",
      "match": "(:max-(?:steps|bytes))(\\s+)([0-9]+)(?=\\s)",
      "captures": {
        "1": {
          "name": "variable.parameter.role.bifrost-rql"
        },
        "3": {
          "name": "constant.numeric.integer.decimal.bifrost-rql"
        }
      }
    },
    {
      "name": "variable.parameter.role.bifrost-rql",
      "match": ":(?:args|arity|attributes|boolean[-_]value|callee|capture|children|class(?:es)?|columns|completen(?:ess|esses)|config[-_]gated|consumers?|declaration[-_]only|decorators|depth|domains?|element[-_]name|elements|fact[-_](?:ordinal|ordinals)|field|formats?|formal[-_](?:index|name)|forms?|has|global|identity|index|inputs?|iterable|keys?|kwargs|left|boundar(?:y|ies)|hoisting|include[-_]shadowed|min[-_]segments|node[-_](?:kind|kinds)|scalar[-_](?:kind|kinds)|origins?|resolved|resolves[-_]to|routes?|max-(?:bytes|steps)|max|min|member[-_]target[-_]id|module|name(?:/regex)?|namespaces?|outcomes?|not[-_]has|not[-_]kind|object|parameter-(?:index|name|type(?:/regex)?)|plan-ref|proof|property|property[-_]name|provenances?|protocol-ref|receiver(?:[-_](?:identity[-_]id|type))?|reference-kinds|relation(?:s)?|right|roles?|runtime|site[-_]class|source[-_]origin|subjects?|tag|value|certaint(?:y|ies)|surface|tiers?|taint[-_]ref|text/regex|transitive|usage|visibility|where)(?=$|[\\s()\\[\\]])"
    },
    {
      "name": "support.function.wrapper.bifrost-rql",
      "match": "\\b(?:absent[-_]member|assignable[-_]to|call-input|call[-_]shape|class[-_]set|call[-_]results|call[-_]argument[-_]groups|call[-_]arguments|call[-_]argument|call[-_]bindings|call[-_]result[-_]contracts|callable[-_]signature|signature[-_]parameters|callable[-_]applicability|overload[-_]selection|configuration[-_]facts|resolved[-_]call|jsx[-_]attribute[-_]value|field[-_]write[-_]value|call-sites-from|call-sites-to|callees|callers|cfg-edge-source|cfg-edge-target|cfg-entry|cfg-exits|cfg-predecessor-edges|cfg-successor-edges|cfg_edge_source|cfg_edge_target|cfg_entry|cfg_exits|cfg_predecessor_edges|cfg_successor_edges|concurrent[-_]access[-_]conflicts|enclosing-decl|except|explain|field|file-of|filter|importers-of|imports-of|inside-decl|inside_decl|inside|intersect|keyed[-_]read[-_]value|language|languages|limit|member-targets|member[-_]selection|members|generation[-_]sites|generates|generated[-_]by|dispatch[-_]outcome|dispatch[-_]targets|member[-_]family|family[-_]edges|declaration[-_]state[-_]of|implementation[-_]of|stubs[-_]of|export[-_]target|exports|export|binding[-_]of|binding[-_]occurrence|bindings[-_]in|bindings|binding|candidate[-_]hierarchy|candidate[-_]target|candidates[-_]of|edge[-_]target|edges[-_]from|edges[-_]of|state[-_]events[-_]of|control[-_]relations|guards[-_]of|flow[-_]relations[-_]of|flow[-_]source|flow[-_]target|result[-_]contract[-_](?:calls|uses|operation[-_]uses|failure[-_]uses)|rewrite[-_]paths[-_]of|not-inside|occurrences[-_]of|occurrences[-_]in|occurrence[-_]target|occurrences|occurrence|owner|points-to|project|scope[-_]ancestors|scope[-_]of|scopes|scope|paths|path|segments[-_]of|segment[-_]target|procedure-of|procedure_of|profile|receiver-targets|receiver[-_]outcome|receiver[-_]evidence|references-of|result-detail|subtypes|supertypes|taint|typestate|union|used-by|uses|value-flow|value_flow|where|witness)\\b"
    },
    {
      "name": "entity.name.type.kind.bifrost-rql",
      "match": "\\b(?:assignment|block|boolean_literal|call|callable|catch|class|collection_literal|concurrent_spawn|constructor|computed_property|declaration|decorator|field_access|for_loop|function|identifier|if|import|jsx_attribute|jsx_element|jsx_spread_attribute|lambda|literal|loop|method|module|null_literal|numeric_literal|object_property|parameter|return|string_literal|spread_element|throw|while_loop)\\b"
    },
    {
      "name": "support.function.predicate.bifrost-rql",
      "match": "\\b(?:arity|boolean[-_]value|capture|eq|ge|gt|has|in|is[-_]not[-_]null|is[-_]null|le|lt|name(?:/regex)?|ne|not[-_]has|not[-_]kind|parameter-type(?:/regex)?|text/regex|visibility)\\b"
    },
    {
      "name": "constant.language.configuration-format.bifrost-rql",
      "match": "(?<![A-Za-z0-9_-])(?:yaml|yml|toml|json|xml|properties|props|property)(?=[\\s)\\]])"
    },
    {
      "name": "support.function.configuration-route.bifrost-rql",
      "match": "\\b(?:key|index|any)\\b(?=\\s+(?:\\\"|[0-9])|\\s*\\))"
    },
    {
      "name": "constant.language.configuration-node-kind.bifrost-rql",
      "match": "(?<![A-Za-z0-9_-])(?:document|object|section|sequence|member|scalar)(?=[\\s)\\]])"
    },
    {
      "name": "constant.language.configuration-member-role.bifrost-rql",
      "match": "(?<![A-Za-z0-9_-])(?:object[-_]member|table[-_]entry|property|xml[-_]attribute|xml[-_]element)(?=[\\s)\\]])"
    },
    {
      "name": "constant.language.configuration-scalar-kind.bifrost-rql",
      "match": "(?<![A-Za-z0-9_-])(?:string|boolean|integer|decimal|null|url|duration|opaque)(?=[\\s)\\]])"
    },
    {
      "name": "constant.language.configuration-provenance.bifrost-rql",
      "match": "(?<![A-Za-z0-9_-])authored(?=[\\s)\\]])"
    },
    {
      "name": "constant.language.configuration-completeness.bifrost-rql",
      "match": "(?<![A-Za-z0-9_-])(?:complete|incomplete)(?=[\\s)\\]])"
    },
    {
      "name": "constant.language.boolean.bifrost-rql",
      "match": "\\b(?:true|false)\\b"
    },
    {
      "name": "meta.hierarchy-depth.bifrost-rql",
      "match": "(:depth\\s+)([0-9]+)(?=\\s)",
      "captures": {
        "1": {
          "name": "variable.parameter.role.bifrost-rql"
        },
        "2": {
          "name": "constant.numeric.integer.decimal.bifrost-rql"
        }
      }
    },
    {
      "name": "meta.hierarchy-transitive.bifrost-rql",
      "match": "(:transitive\\s+)(true)(?=\\s)",
      "captures": {
        "1": {
          "name": "variable.parameter.role.bifrost-rql"
        },
        "2": {
          "name": "constant.language.boolean.true.bifrost-rql"
        }
      }
    },
    {
      "name": "meta.limit.bifrost-rql",
      "match": "(\\(\\s*limit\\s+)([0-9]+)(?=\\s)",
      "captures": {
        "1": {
          "name": "support.function.wrapper.bifrost-rql"
        },
        "2": {
          "name": "constant.numeric.integer.decimal.bifrost-rql"
        }
      }
    },
    {
      "name": "meta.result-detail.bifrost-rql",
      "match": "(\\(\\s*result-detail\\s+)(compact|full)(?=\\s)",
      "captures": {
        "1": {
          "name": "support.function.wrapper.bifrost-rql"
        },
        "2": {
          "name": "constant.language.result-detail.bifrost-rql"
        }
      }
    }
  ]
}
