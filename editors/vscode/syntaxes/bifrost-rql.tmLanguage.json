{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Bifrost Rune Query Language",
  "scopeName": "source.bifrost-rql",
  "patterns": [
    {
      "match": "(^|\\s)(;.*$)",
      "captures": {
        "2": {
          "name": "comment.line.semicolon.bifrost-rql"
        }
      }
    },
    {
      "name": "meta.regex-predicate.bifrost-rql",
      "match": "(\\(|:)(?:\\s*)((?:name|text)/regex)(?:\\s*)(\\\")((?:\\\\.|[^\\\"\\\\])*)(\\\")",
      "captures": {
        "1": {
          "name": "punctuation.section.parens.begin.bifrost-rql"
        },
        "2": {
          "name": "support.function.predicate.bifrost-rql"
        },
        "3": {
          "name": "punctuation.definition.string.begin.bifrost-rql"
        },
        "4": {
          "name": "string.regexp.bifrost-rql"
        },
        "5": {
          "name": "punctuation.definition.string.end.bifrost-rql"
        }
      }
    },
    {
      "name": "string.quoted.double.bifrost-rql",
      "match": "\\\"(?:\\\\.|[^\\\"\\\\])*\\\""
    },
    {
      "name": "punctuation.section.brackets.bifrost-rql",
      "match": "(?:\\((?!\\s*(?:limit|result-detail)\\s)|[)\\[\\]])"
    },
    {
      "name": "meta.typestate-witness-limit.bifrost-rql",
      "match": "(:max-(?:steps|bytes))(\\s+)([0-9]+)(?=\\s)",
      "captures": {
        "1": {
          "name": "variable.parameter.role.bifrost-rql"
        },
        "3": {
          "name": "constant.numeric.integer.decimal.bifrost-rql"
        }
      }
    },
    {
      "name": "variable.parameter.role.bifrost-rql",
      "match": ":(?:args|callee|capture|class(?:es)?|completeness|config[-_]gated|declaration[-_]only|decorators|depth|field|forms?|has|inputs?|kwargs|left|boundar(?:y|ies)|hoisting|include[-_]shadowed|origins?|max-(?:bytes|steps)|module|name(?:/regex)?|namespaces?|outcomes?|not[-_]has|not[-_]kind|object|parameter-(?:index|name)|plan-ref|proof|protocol-ref|receiver|reference-kinds|right|roles?|surface|tiers?|taint[-_]ref|text/regex|transitive)(?=$|[\\s()\\[\\]])"
    },
    {
      "name": "support.function.wrapper.bifrost-rql",
      "match": "\\b(?:call-input|call-sites-from|call-sites-to|callees|callers|cfg-edge-source|cfg-edge-target|cfg-entry|cfg-exits|cfg-predecessor-edges|cfg-successor-edges|cfg_edge_source|cfg_edge_target|cfg_entry|cfg_exits|cfg_predecessor_edges|cfg_successor_edges|enclosing-decl|except|explain|file-of|importers-of|imports-of|inside-decl|inside_decl|inside|intersect|language|languages|limit|member-targets|members|generation[-_]sites|generates|generated[-_]by|declaration[-_]state[-_]of|implementation[-_]of|export[-_]target|exports|export|binding[-_]occurrence|bindings[-_]in|bindings|binding|candidate[-_]target|candidates[-_]of|not-inside|occurrences[-_]of|occurrences[-_]in|occurrence[-_]target|occurrences|occurrence|owner|points-to|reaching[-_]binding|scope[-_]ancestors|scope[-_]of|scopes|scope|procedure-of|procedure_of|profile|receiver-targets|references-of|result-detail|subtypes|supertypes|taint|typestate|union|used-by|uses|value-flow|value_flow|where|witness)\\b"
    },
    {
      "name": "entity.name.type.kind.bifrost-rql",
      "match": "\\b(?:assignment|block|boolean_literal|call|callable|catch|class|constructor|declaration|decorator|field_access|for_loop|function|identifier|if|import|lambda|literal|loop|method|null_literal|numeric_literal|return|string_literal|throw|while_loop)\\b"
    },
    {
      "name": "support.function.predicate.bifrost-rql",
      "match": "\\b(?:capture|has|name(?:/regex)?|not[-_]has|not[-_]kind|text/regex)\\b"
    },
    {
      "name": "meta.hierarchy-depth.bifrost-rql",
      "match": "(:depth\\s+)([0-9]+)(?=\\s)",
      "captures": {
        "1": {
          "name": "variable.parameter.role.bifrost-rql"
        },
        "2": {
          "name": "constant.numeric.integer.decimal.bifrost-rql"
        }
      }
    },
    {
      "name": "meta.hierarchy-transitive.bifrost-rql",
      "match": "(:transitive\\s+)(true)(?=\\s)",
      "captures": {
        "1": {
          "name": "variable.parameter.role.bifrost-rql"
        },
        "2": {
          "name": "constant.language.boolean.true.bifrost-rql"
        }
      }
    },
    {
      "name": "meta.limit.bifrost-rql",
      "match": "(\\(\\s*limit\\s+)([0-9]+)(?=\\s)",
      "captures": {
        "1": {
          "name": "support.function.wrapper.bifrost-rql"
        },
        "2": {
          "name": "constant.numeric.integer.decimal.bifrost-rql"
        }
      }
    },
    {
      "name": "meta.result-detail.bifrost-rql",
      "match": "(\\(\\s*result-detail\\s+)(compact|full)(?=\\s)",
      "captures": {
        "1": {
          "name": "support.function.wrapper.bifrost-rql"
        },
        "2": {
          "name": "constant.language.result-detail.bifrost-rql"
        }
      }
    }
  ]
}
