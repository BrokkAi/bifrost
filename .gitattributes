# Policy sources and formatter golds are compared with exact byte ranges.
*.rqlp text eol=lf

# The py16 comment policy test compares exact comment byte spans; the Python
# grammar's comment token would include a CRLF checkout's carriage return.
tests/fixtures/py16-commented-out-code/*.py text eol=lf

# Typestate canonical contracts are compared byte for byte.
tests/fixtures/typestate/*.canonical*.json text eol=lf

